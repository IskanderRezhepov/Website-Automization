Name=\"off\";\r\n                    inputs.checked=false; }\r\n                  else {\r\n                    for (i=0;i<tr_intab.length;i++) {\r\n                       if (tr_intab[i].className=\"onCL_1\") {\r\n                        tr_intab[i].className=\"off\";\r\n                       }\r\n                    }\r\n                    inputs.checked=true;\r\n                    tr_in.className=\"onCL_1\";\r\n                  }\r\n                  f_pdos_document_ch(a);\r\n               }\r\n               </script>\n<script>function f_message_send(){\r\n                           $.ajax({\r\n                                   url:\"pkg_w_e_dossier.p_message_send\",\r\n                                   type:\"POST\",\r\n                                   data:{p_send : 1},\r\n                                   success:function(data)\r\n                                           {\r\n                                            $(\"#dossier_info\").append(data);\r\n                                           }\r\n                                  });\r\n                        };\r\n     $(document).keydown(function(e) {\r\n               if (e.which == 119) {\r\n                        $(\"#search\").focus();\r\n               }\r\n     });\r\n     /*-------------------Прорисовка панелек---------------*/\r\n     $(document).ready(function(){\r\n         var availableTags = [\r\n              \"ActionScript\",\r\n              \"AppleScript\",\r\n              \"Asp\",\r\n              \"BASIC\",\r\n              \"C\",\r\n              \"C++\"\r\n            ];\r\n        $(\"#search\").autocomplete({\r\n          minLength: 2,\r\n          source :  \"\" , //s_search_var,\r\n          select: function (event, ui) {\r\n               var search_text = ui.item.value;\r\n                $(\"#search\").val(search_text);\r\n               p_get_document_search();\r\n             }\r\n        });\r\n        $(\"#search\").keypress(function(event){\r\n           if (event.keyCode == 13) {\r\n                    p_get_document_search();\r\n           }\r\n        });\r\n        $(\"#img_btn\").click(function() {\r\n            var cust_ids=$(\"input[name=r_pcust_shortname]:checked\").val() ? $(\"input[name=r_pcust_shortname]:checked\").val() : \"\";\r\n            var search_txt=$(\"#search\").val();\r\n            if (cust_ids==\"\"){\r\n                  alert(\"Выберите клиента!\");\r\n               }\r\n            else\r\n              if(search_txt==\"\"){\r\n                  alert(\"Введите данные для поиска!\");\r\n              }\r\n              else {\r\n                  p_get_document_search();\r\n              }\r\n        });\r\n           $(\"#accordion\").accordion({\r\n               collapsible: true,\r\n               duration: 3000,\r\n               beforeActivate: function(event, ui) {\r\n                   if (ui.newHeader[0])\r\n                   {\r\n                       var currHeader  = ui.newHeader;\r\n                       var currContent = currHeader.next('.ui-accordion-content');\r\n                   } else\r\n                   {\r\n                       var currHeader  = ui.oldHeader;\r\n                       var currContent = currHeader.next('.ui-accordion-content');\r\n                    }\r\n                    var isPanelSelected = currHeader.attr('aria-selected') == 'true';\r\n                    currHeader.toggleClass('ui-corner-all',isPanelSelected).toggleClass('accordion-header-active ui-state-active ',!isPanelSelected).attr('aria-selected',((!isPanelSelected).toString()));\r\n                    currHeader.children('.ui-icon').toggleClass('ui-icon-triangle-1-e',isPanelSelected).toggleClass('ui-icon-triangle-1-s',!isPanelSelected);\r\n                    currContent.toggleClass('accordion-content-active',!isPanelSelected);\r\n                    if (isPanelSelected) {\r\n                       currContent.slideUp();}\r\n                    else {\r\n                       currContent.slideDown();\r\n                    }\r\n                    return false;\r\n                }\r\n           });\r\n           $(\"#cust_search\").css({height:\"auto\"});\r\n           $(\".ui-accordion\").css(\"width\",\"98%\");\r\n           $(\"#cust_search\").css(\"background\",\"#B0C4DE\");\r\n           });\r\n            /*-Позиционирование панелек-*/\r\n            function ReSize() {\r\n               if($(\"#accordion>h3\").hasClass(\"ui-state-active\"))\r\n                    {\r\n                     $(\"#center\").css({height:\"250\", width:\"100%\", position: \"static\", overflow: \"auto\"});\r\n                     $(\"#bottom\").css({height:\"200\", width:\"100%\", position: \"static\", overflow: \"auto\"});\r\n                    }\r\n               else {\r\n                     $(\"#center\").css({height:\"350\", width:\"100%\", position: \"static\", overflow: \"auto\"});\r\n                     $(\"#bottom\").css({height:\"300\", width:\"100%\", position: \"static\", overflow: \"auto\"});\r\n                    }\r\n              }\r\n            /*-----------------------------------------------------*/\r\n                  /*----------------Поиск клиента------------------------*/\r\n                  function f_cust_search(param){\r\n                    $(\"#buttons\").hide();\r\n                    $(\"#b_dossier_attitude\").hide();\r\n                    $(\"#b_doc_attitude\").hide();\r\n                    $(\"#b_add\").hide();\r\n                    $(\"#cust_table\").empty();\r\n                    $(\"#dossier_info\").empty();\r\n                    $(\"#document_info\").empty();\r\n                    $(\"#cust_load\").show();\r\n                    switch(param) {\r\n                         case \"search\":\r\n                             p_min = 0;\r\n                             p_max = $(\"#h_count\").val();\r\n                             break;\r\n                        case \"next\":\r\n                            p_min = p_max;\r\n                            p_max = parseInt(p_max) + parseInt($(\"#h_count\").val());\r\n                            break;\r\n                        case \"prev\":\r\n                            p_max = p_min;\r\n                            p_min = parseInt(p_min) - parseInt($(\"#h_count\").val()); - parseInt($(\"#h_count\").val());\r\n                            break;\r\n                   }\r\n                   $.ajax({\r\n                           url:\"pkg_w_e_dossier.p_main_table\",\r\n                       //   alert(\"sds\");\r\n                           type:\"POST\",\r\n                           data:{p_cust_shortname   : $(\"#t_cust_shortname\").val(),\r\n                                 p_dossier_number   : $(\"#t_dossier_number\").val(),\r\n                                 p_iin_bin          : $(\"#t_iin_bin\").val(),\r\n                                 p_pcust_shortname  : $(\"#t_pcust_shortname\").val(),\r\n                                 p_sloan_agreement  : $(\"#t_sloan_agreement\").val(),\r\n                                 p_min_row_to_fetch : p_min,\r\n                                 p_max_row_to_fetch : p_max},\r\n                           success:function(data)\r\n                                   {\r\n                                    $(\"#cust_load\").hide();\r\n                                    $(\"#cust_table\").empty();\r\n                                    $(\"#cust_table\").append(data);\r\n                                   },\r\n                                    error: function(xhr, status, error){\r\n                                                 var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                 alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                 $(\"#cust_load\").hide();\r\n                                                 $(\"#cust_table\").empty();\r\n                                            }\r\n                           });\r\n                  }\r\n                       /*---Действия при выборе клиента, прорисовка 2 фрема---*/\r\n                       function f_cust_choice(){\r\n                                               $(\"#buttons\").hide();\r\n                                               $(\"#b_dossier_attitude\").hide();\r\n                                               $(\"#b_doc_attitude\").hide();\r\n                                               $(\"#b_cut_dossier\").hide();\r\n                                               $(\"#b_sloan_attitude\").hide();\r\n                                               $(\"#b_return_dossier\").hide();\r\n                                               $(\"#b_return_dossier_replace\").hide();\r\n                                               $(\"#b_get_arh_dossier\").hide();\r\n                                               $(\"#b_upd_return_date\").hide();\r\n                                               $(\"#b_add\").show();\r\n                                               $(\"#dossier_info\").empty();\r\n                                               $(\"#document_info\").empty();\r\n                                               $(\"#dossier_load\").show();\r\n                                               $.ajax({\r\n                                                       url:\"pkg_w_e_dossier.p_dossier_info\",\r\n                                                       type:\"POST\",\r\n                                                       data:{p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                             p_dossier         : $(\"#h_pdossier\").val(),\r\n                                                             p_access          : $(\"#n_access\").val(),\r\n                                                             p_sloan_agreement : $(\"#r_sloan_agreement\") ? $(\"#r_sloan_agreement\").val() : \"\"\r\n                                                             },\r\n                                                       success:function(data)\r\n                                                               {\r\n                                                                $(\"#dossier_load\").hide();\r\n                                                                $(\"#dossier_info\").append(data);\r\n                                                               },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                   $(\"#dossier_load\").hide();\r\n                                                                              }\r\n                                                       });\r\n                                               }\r\n</script>\n<script>        /*--------Добавление нового досье---------------------*/\r\n                       function f_add_dossier(){\r\n                                             //  alert($(\"input[name=r_pcust_shortname]:checked\").val());\r\n                                               if ($(\"input[name=r_pcust_shortname]:checked\").val()==null)\r\n                                                {\r\n                                                 alert(\"Выберите клиента\");\r\n                                                }\r\n                                                else\r\n                                                {\r\n                                                 if (confirm(\"Cоздать новое досье?\"))\r\n                                                  {\r\n                                                     $(\"#buttons\").hide();\r\n                                                     $(\"#b_dossier_attitude\").hide();\r\n                                                     $(\"#b_cut_dossier\").hide();\r\n                                                     $(\"#b_sloan_attitude\").hide();\r\n                                                     $(\"#b_return_dossier\").hide();\r\n                                                     $(\"#b_return_dossier_replace\").hide();\r\n                                                     $(\"#b_get_arh_dossier\").hide();\r\n                                                     $(\"#b_upd_return_date\").hide();\r\n                                                     $(\"#dossier_info\").empty();\r\n                                                     $(\"#document_info\").empty();\r\n                                                     $(\"#document_load\").show();\r\n                                                     $.ajax({\r\n                                                             url:\"pkg_w_e_dossier.p_document_info\",\r\n                                                             type:\"POST\",\r\n                                                             data:{p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                                   p_button          : \"add_dossier\",\r\n                                                                   p_new_dossier_num : 1,\r\n                                                                   p_sloan_agreement : $(\"#r_sloan_agreement\") ? $(\"#r_sloan_agreement\").val() : \"\"\r\n                                                                   },\r\n                                                             success:function(data)\r\n                                                                     {\r\n                                                                      $(\"#document_load\").hide();\r\n                                                                      $(\"#document_info\").append(data);\r\n                                                                     },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                    $(\"#document_load\").hide();\r\n                                                                              }\r\n                                                             });\r\n                                                   }\r\n                                                  }\r\n                                               }\r\n                       /*----------------------Одобрить-----------------------*/\r\n                                            function f_approve_dossier(){\r\n                                                    if (confirm(\"Одобрить?\"))\r\n                                                       {\r\n                                                          f_download(\"open\");\r\n                                                        $.ajax({\r\n                                                                url:\"pkg_w_e_dossier.p_action\",\r\n                                                                type:\"POST\",\r\n                                                                data:{p_dossier       : $(\"#h_pdossier\").val(),\r\n                                                                      p_code          : 6},\r\n                                                                success:function(data)\r\n                                                                        {\r\n                                                                         $(\"#document_info\").append(data);\r\n                                                                         document_show_2();\r\n                                                                          f_download(\"close\");\r\n                                                                          f_upd_dossier();\r\n                                                           },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                   document_show_2();\r\n                                                                                   f_download(\"close\");\r\n                                                                                   f_upd_dossier();\r\n                                                                              }\r\n                                                               });\r\n                                                        }\r\n                                                   }\r\n                        /*---------------Отправить досье в архив---------------*/\r\n                       function f_get_to_archive_dossier(){\r\n                                                           var status = $(\"#h_status\").val();\r\n                                                           if (status==4 || status==3|| status == 9)\r\n                                                              {\r\n                                                                if (confirm(\"Отправить досье в архив?\"))\r\n                                                                   {\r\n                                                                    $.ajax({\r\n                                                                            url:\"pkg_w_e_dossier.p_action\",\r\n                                                                            type:\"POST\",\r\n                                                                            data:{p_dossier       : $(\"#h_pdossier\").val(),\r\n                                                                                  p_code          : 15},\r\n                                                                            success:function(data)\r\n                                                                                    {\r\n                                                                                     $(\"#document_info\").append(data);\r\n                                                                                     document_show_1();\r\n                                                                                    },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                   document_show_1();\r\n                                                                              }\r\n                                                                           });\r\n                                                                    }\r\n                                                               }\r\n                                                             else\r\n                                                               {\r\n                                                                alert(\"Невозможно отправить досье в архив.Досье не в хранилище\");\r\n                                                               }\r\n                                                           }\r\n                       /*-------Выбор, изменение существующего досье----------*/\r\n                       function f_upd_dossier(){\r\n                                               $(\"#buttons\").show();\r\n                                               $(\"#b_dossier_attitude\").show();\r\n                                               $(\"#b_sloan_attitude\").show();\r\n                                               $(\"#all_buttons\").attr(\"disabled\",true);\r\n                                               $(\"#dossier_load\").show();\r\n                                               var n_dossier=$(\"input[name=r_pdossier]:checked\").val();\r\n                                               $.ajax({\r\n                                                       url:\"pkg_w_e_dossier.p_dossier_info\",\r\n                                                       type:\"POST\",\r\n                                                       data:{p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                             p_dossier         : $(\"input[name=r_pdossier]:checked\").val(),\r\n                                                             p_access          : $(\"#n_access\").val(),\r\n                                                             p_arh_status      : $(\"#h_arh_status\").val(),\r\n                                                             p_sloan_agreement : $(\"#r_sloan_agreement\") ? $(\"#r_sloan_agreement\").val() : \"\"\r\n                                                             },\r\n                                                         beforeSend: function(){\r\n                                                           $(\"#document_load\").show();\r\n                                                        },\r\n                                                       success:function(data)\r\n                                                               {\r\n                                                                $(\"#dossier_info\").empty();\r\n                                                                $(\"#dossier_info\").append(data);\r\n                                                                $(\"#dossier_load\").hide();\r\n                                                                if ($(\"#h_arh_status\").val()==0)\r\n                                                                 {$(\"#dossier_on\").css(\"color\",\"#778899\");\r\n                                                                  $(\"#dossier_off\").css(\"color\",\"black\");}\r\n                                                                else\r\n                                                                 {$(\"#dossier_on\").css(\"color\",\"black\");\r\n                                                                  $(\"#dossier_off\").css(\"color\",\"#778899\");}\r\n                                                               },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                    alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                    $(\"#dossier_info\").empty();\r\n                                                                                    $(\"#dossier_load\").hide();\r\n                                                                                    if ($(\"#h_arh_status\").val()==0)\r\n                                                                                       {  $(\"#dossier_on\").css(\"color\",\"#778899\");\r\n                                                                                          $(\"#dossier_off\").css(\"color\",\"black\");\r\n                                                                                        }\r\n                                                                                    else\r\n                                                                                        { $(\"#dossier_on\").css(\"color\",\"black\");\r\n                                                                                          $(\"#dossier_off\").css(\"color\",\"#778899\");\r\n                                                                                        }\r\n                                                                              }\r\n                                                       });\r\n                                                   $(\"#document_info\").attr(\"disabled\",true);\r\n                                               //alert(\"TEST\");\r\n                                                $.ajax({\r\n                                                       url:\"pkg_w_e_dossier.p_document_info\",\r\n                                                       type:\"POST\",\r\n                                                       data:{p_dossier         : n_dossier,//$(\"input[name=r_pdossier]:checked\").val(),\r\n                                                             p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                             p_button          : \"change_dossier\",\r\n                                                       //    p_button          : \"Изменить_досье\",\r\n                                                             p_access          : $(\"#n_access\").val(),\r\n                                                             p_arh_status      : $(\"#h_arh_status\").val()},\r\n                                                        beforeSend: function(){\r\n                                                           $(\"#document_load\").show();\r\n                                                        },\r\n                                                       success:function(data)\r\n                                                               {\r\n                                                                $(\"#document_info\").empty();\r\n                                                                $(\"#document_info\").append(data);\r\n                                                                $(\"#document_info\").attr(\"disabled\",false);\r\n                                                                $(\"#all_buttons\").attr(\"disabled\",false);\r\n                                                                $(\"#document_load\").hide();\r\n                                                               },\r\n                                                        error: function(xhr, status, error){\r\n                                                                     var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                     alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                    $(\"#document_info\").empty();\r\n                                                                    $(\"#document_info\").attr(\"disabled\",false);\r\n                                                                    $(\"#all_buttons\").attr(\"disabled\",false);\r\n                                                                    $(\"#document_load\").hide();\r\n                                                                }\r\n                                                       });\r\n                                               }\r\n                       /*-------------------Кнопка очистить-------------------*/\r\n                       function f_input_clear(){\r\n                                                $(\"#t_cust_shortname\").val(null);\r\n                                                $(\"#t_dossier_number\").val(null);\r\n                                                $(\"#t_iin_bin\").val(null);\r\n                                                $(\"#t_pcust_shortname\").val(null);\r\n                                                $(\"#t_sloan_agreement\").val(null);\r\n                                               }\r\n                       /*----------------Отменить новое досье-----------------*/\r\n                       function f_del_dossier(){\r\n                                                if (confirm(\"Досье будет закрыто без сохранения. Продолжить?\"))\r\n                                                   {\r\n                                                     var a;\r\n                                                     a=$(\"#p_dossier\").val();\r\n                                                     $.ajax({\r\n                                                             url:\"pkg_w_e_dossier.p_document_info\",\r\n                                                             type:\"POST\",\r\n                                                             data:{p_dossier         : a,\r\n                                                             p_button          : \"del_dossier\"},\r\n                                                          // p_button          : \"Удалить_досье\"},\r\n                                                             success:function(data)\r\n                                                                     {\r\n                                                                     $(\"#dossier_info\").empty();\r\n                                                                     $(\"#document_info\").empty();\r\n                                                                     $(\"#document_info\").append(data);\r\n                                                                     f_cust_choice();\r\n                                                                     },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                   $(\"#dossier_info\").empty();\r\n                                                                                   $(\"#document_info\").empty();\r\n                                                                                   f_cust_choice();\r\n                                                                              }\r\n                                                            });\r\n                                                   }\r\n                                                }\r\n                       /*-----------------------------------------------------*/\r\n                       </script>\n<script>\r\n    /*-------------------Отключение пользователя каждые пол часа-------------------*/\r\n    function logout(url){\r\n      var str = url.replace(\"https://\", \"https://\" + new Date().getTime() + \"@\");\r\n      var xmlhttp;\r\n      if (window.XMLHttpRequest) xmlhttp=new XMLHttpRequest();\r\n      else xmlhttp=new ActiveXObject(\"Microsoft.XMLHTTP\");\r\n      xmlhttp.onreadystatechange=function()\r\n      {\r\n          if (xmlhttp.readyState==4) location.reload();\r\n      }\r\n      xmlhttp.open(\"GET\",str,true);\r\n      xmlhttp.setRequestHeader(\"Authorization\",\"Basic YXNkc2E6\")\r\n      xmlhttp.send();\r\n      return false;\r\n    }\r\n    function callLogout(){\r\n      url = window.location.toString();\r\n      logout(url);\r\n    }\r\n   setTimeout(callLogout, 30 * 60 * 1000);\r\n  /*-------------------------------------------------------------------------------*/\r\n   </script>\n<script>\r\n                     /*------------Текущее состояние документов-------------*/\r\n                       function p_get_document_status()\r\n                                                     {\r\n                                                      var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_get_document_status?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                      win=window.open(s_url, \"p_get_document_status\", params);\r\n                                                     };\r\n          /*------------Результаты поиска документов-------------*/\r\n                       function p_get_document_search()\r\n                                                     {var s_cust_id=$(\"input[name=r_pcust_shortname]:checked\").val();\r\n                                                      var s_search_value=$(\"#search\").val();\r\n                                                      var s_dossier_id=$(\"#h_p_dossier\").val() ? $(\"#h_p_dossier\").val() : \"\";\r\n                                                      var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_search_form?p_scust_shortname=\"+s_cust_id+\"&p_pdossier=\"+s_dossier_id+\"&p_search_text=\"+s_search_value;\r\n                                                      win=window.open(s_url, \"p_get_document_search\", params);\r\n                                                     };\r\n                      /*------------------Контрольный лист--------------------*/\r\n                      function f_get_check_list()\r\n                                                {\r\n                                                 var params = \"width=1400,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                 var s_url = \"pkg_w_e_check_list.p_main?p_sdossier=\"+$(\"#h_p_dossier\").val()\r\n                                                                                       +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                 win=window.open(s_url, \"p_main\", params);\r\n                                                };\r\n                      /*------------------Автоматическая загрузка--------------------*/\r\n                      function f_uplod_files()\r\n                                                {\r\n                                                  str=\"pkg_w_e_dossier.p_upload_dir?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                  check_load=window.open(str,\"upload_files\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load.focus();\r\n                                                };\r\n                    /*------------------Автоматическая загрузка по референсам--------------------*/\r\n                      function f_uplod_files_ref()\r\n                                                {\r\n                                                  str=\"pkg_w_load_docs.p_upload_dir\";\r\n                                                  check_load_ref=window.open(str,\"upload_files_ref\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load_ref.focus();\r\n                                                };\r\n                      /*------------------Автоматическая загрузка фото и видео--------------------*/\r\n                      function f_uplod_fv()\r\n                                                {\r\n                                                  str=\"pkg_w_e_dossier.p_upload_dir_fv?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                  check_load=window.open(str,\"upload_files\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load.focus();\r\n                                                };\r\n                     /*------------------Автоматическая загрузка из папки--------------------*/\r\n                      function f_uplod_folder()\r\n                                                {\r\n                                                  str=\"pkg_w_e_dossier.p_upload_folder?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                  check_load=window.open(str,\"upload_files\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load.focus();\r\n                                                };\r\n                     /*------------------Заполнение параметров--------------------*/\r\n                       function f_insert_files()\r\n                                                {\r\n                                                  str=\"pkg_w_e_dossier.p_insert_document?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                  check_load=window.open(str,\"upload_files\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load.focus();\r\n                                                };\r\n                      /*------------------Заполнение параметров из папки--------------------*/\r\n                       function f_insert_folder()\r\n                                                {\r\n                                                  str=\"pkg_w_e_dossier.p_insert_document_fol?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                  check_load=window.open(str,\"upload_files\",\"toolbar=1,location=1,directories=1,status=1,menubar=1,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  check_load.focus();\r\n                                                };\r\n                        /*------------------Копирование ссылки--------------------  Доработка Какимжан Е.Б.  */\r\n                               function Copy()\r\n                                                {\r\n                                                var str = document.getElementById(\"pasteurl\");\r\n                                                var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                var s_url =\"https://bcc-app.bank.corp.centercredit.kz:4030//ecd/pkg_w_e_dossier.p_video_photo?p_dossier=\"+$(\"#h_p_dossier\").val();\r\n                                                str.type = 'text';\r\n                                                str.value=  s_url;\r\n                                                str.focus();\r\n                                                str.select();\r\n                                                document.execCommand(\"Copy\");\r\n                                                str.type = 'hidden';\r\n                                                alert('Ссылка скопирована!')\r\n                                                window.open(s_url);\r\n                                                 };\r\n                      /*-------------------Сформировать опись-----------------*/\r\n                       function f_create_inventory()\r\n                                                     {\r\n                                                      alert(\"Формирование описи может занимать по времени до нескольких минут в зависимости от размера досье. Пожалуйста ожидайте окончания\");\r\n                                                      var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_create_inventory?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n                                                                  +\"&p_print=\"+0\r\n                                                                  +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_create_inventory\", params);\r\n                                                     };\r\n                     /*---------------------Привязка к досье------------------*/\r\n                       function f_dossier_attitude()\r\n                                                     {\r\n                                                      var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_dossier_attitude?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n                                                                  +\"&p_scust_shortname=\"+$(\"input[name=r_pcust_shortname]:checked\").val()\r\n                                                                  +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_dossier_attitude\", params);\r\n                                                     };\r\n                     /*---------------------Привязка к колвиру------------------*/\r\n                       function f_colvir_attitude()\r\n                                                     {\r\n                                                      var params = \"width=800,height=400,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes,toolbar=no,directories=no,titlebar=no\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_attitude_colvir?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n                                                                  +\"&p_pcust_shortname=\"+$(\"input[name=r_pcust_shortname]:checked\").val()\r\n                                                                  +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win_colvir=window.open(s_url, \"p_colvir_attitude\", params);\r\n                                                     };\r\n/*---------------------Привязка к общим документам------------------*/\r\n                       function f_doс_attitude()\r\n                                                     {\r\n                                                      var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_doc_attitude?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n                                                                  +\"&p_scust_shortname=\"+$(\"input[name=r_pcust_shortname]:checked\").val()\r\n                                                                  +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_doc_attitude\", params);\r\n                                                     };\r\n                     /*-------------------Редактирование даты возврата-----------------*/\r\n                       function f_upd_return_date()\r\n                                                     {var params = \"width=1200,height=800,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_upd_return_date?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n                                                      +\"&p_print=\"+0\r\n                                                      +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_upd_return_date\", params);\r\n                                                     };\r\n/*Изъять досье*/\r\nfunction f_type_cut_note2(){\r\n                    if (($(\"select[name=p_pcut_note2]\").val() == 8) || ($(\"select[name=p_pcut_note2]\").val() == 1) || ($(\"select[name=p_pcut_note2]\").val() == 7) || ($(\"select[name=p_pcut_note2]\").val() == 9) || ($(\"select[name=p_pcut_note2]\").val() == 10) )\r\n                        {\r\n                             //$(\"#p_return_date_dossier\").hide();\r\n                             $(\"#p_return_date_dossier\").attr('disabled','disabled');\r\n                                 } else\r\n                          if (($(\"select[name=p_pcut_note2]\").val() != 8) && ($(\"select[name=p_pcut_note2]\").val() != 1) && ($(\"select[name=p_pcut_note2]\").val() != 7) && ($(\"select[name=p_pcut_note2]\").val() != 9) && ($(\"select[name=p_pcut_note2]\").val() != 10) )\r\n                              {\r\n                                //$(\"#p_return_date_dossier\").show();\r\n                                $(\"#p_return_date_dossier\").removeAttr('disabled');\r\n                                                                  };\r\n                                                }\r\n/*-----------------Корректировка признака совокупность лимита 500 млн --------*/\r\n                      function f_chng_limit(cust_id_in){\r\n                                       s_limit_check = document.getElementById(\"p_limit_500\");\r\n                                       s_trouble_bow = document.getElementById(\"p_trouble_borrow\");\r\n                                       n_lim_value = s_limit_check.checked ? 1 : 0;\r\n                                       n_troub_value = s_trouble_bow.checked ? 1 : 0;\r\n                                                $.ajax({\r\n                                                        url:\"pkg_w_e_dossier.p_action\",\r\n                                                        type:\"POST\",\r\n                                                        data:{P_PCUST_SHORTNAME       : cust_id_in,\r\n                                                              p_code                  : 29,\r\n                                                              p_limit_500_in          : n_lim_value,\r\n                                                              p_trouble_borrower_in   : n_troub_value\r\n                                                              },\r\n                                                        success:function(data)\r\n                                                                { alert(data)\r\n                                                   },error: function(xhr, status, error){\r\n                                                                           var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                           alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                      }\r\n                                                       });\r\n                                                };\r\n                    /*------------------------------Завершение формирования ----*/\r\n                     function f_finish_form(){\r\n                                      if (confirm(\"Завершить формирование досье?\"))\r\n                                         {\r\n                                          f_download(\"open\");\r\n                                          $.ajax({\r\n                                                  url:\"pkg_w_e_dossier.p_action\",\r\n                                                  type:\"POST\",\r\n                                                  data:{p_dossier       : $(\"#h_pdossier\").val(),\r\n                                                        p_code          : 27},\r\n                                                  success:function(data)\r\n                                                          {\r\n                                                           $(\"#document_info\").append(data);\r\n                                                            document_show_2();\r\n                                                            f_download(\"close\");\r\n                                             },error: function(xhr, status, error){\r\n                                                                     var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                     alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                     document_show_2();\r\n                                                                     f_download(\"close\");\r\n                                                                }\r\n                                                 });\r\n                                          }\r\n                             }\r\n                    /*------------------------------*/\r\n                       function f_check_document(){\r\n                       var a;\r\n                       a=$(\"#p_dossier\").val();\r\n                       var c=$.ajax({url : \"pkg_w_e_dossier.P_GET_TYPE_POSTING\",\r\n                           type: \"POST\",\r\n                           data: {P_PDOSSIER : a}\r\n                        , async: false\r\n                           }).responseText;\r\n                       alert(\"c=\"+c);\r\n                       var sres = (c==1) ? 0 : $.ajax({url : \"pkg_w_e_dossier.P_GET_COUNT_DOCUMENT\",\r\n                           type: \"POST\",\r\n                           data: {N_PDOSSIER : a}\r\n                        , async: false\r\n                           }).responseText;\r\n                         if (sres == 0){\r\n                          fail_doc_approve_dial();\r\n                          }else{\r\n                         alert(sres);\r\n                        }\r\n                      }\r\n                      /*-------------Выбор действующих, архивных досье--------*/\r\n                      function f_change_status_dos(id){\r\n                                                      if (id==\"dossier_on\")\r\n                                                      {\r\n                                                       $(\"#buttons\").hide();\r\n                                                       $(\"#b_cut_dossier\").hide();\r\n                                                       $(\"#b_sloan_attitude\").hide();\r\n                                                       $(\"#b_dossier_attitude\").hide();\r\n                             $(\"#b_doc_attitude\").hide();\r\n                                                       $(\"#b_return_dossier\").hide();\r\n                                                       $(\"#b_return_dossier_replace\").hide();\r\n                                                       $(\"#b_get_arh_dossier\").hide();\r\n                                                       $(\"#b_upd_return_date\").hide();\r\n                                                       $(\"#b_add\").show();\r\n                                                       $(\"#dossier_info\").empty();\r\n                                                       $(\"#document_info\").empty();\r\n                                                       $(\"#dossier_load\").show();\r\n                                                       $.ajax({\r\n                                                               url:\"pkg_w_e_dossier.p_dossier_info\",\r\n                                                               type:\"POST\",\r\n                                                               data:{p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                                     p_dossier         : $(\"#h_pdossier\").val(),\r\n                                                                     p_access          : $(\"#n_access\").val(),\r\n                                                                     p_sloan_agreement : $(\"#r_sloan_agreement\") ? $(\"#r_sloan_agreement\").val() : \"\"\r\n                                                                     },\r\n                                                               success:function(data)\r\n                                                                       {\r\n                                                                        $(\"#dossier_load\").hide();\r\n                                                                        $(\"#dossier_info\").append(data);\r\n                                                                        $(\"#dossier_on\").css(\"color\",\"#778899\");\r\n                                                                        $(\"#dossier_off\").css(\"color\",\"black\");\r\n                                                                       },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                   $(\"#dossier_load\").hide();\r\n                                                                                   $(\"#dossier_on\").css(\"color\",\"#778899\");\r\n                                                                                   $(\"#dossier_off\").css(\"color\",\"black\");\r\n                                                                              }\r\n                                                               });\r\n                                                       };\r\n                                                       if (id==\"dossier_off\")\r\n                                                      {\r\n                                                       $(\"#buttons\").hide();\r\n                                                       $(\"#b_cut_dossier\").hide();\r\n                                                       $(\"#b_sloan_attitude\").hide();\r\n                                                       $(\"#b_dossier_attitude\").hide();\r\n                                                       $(\"#b_return_dossier\").hide();\r\n                                                       $(\"#b_return_dossier_replace\").hide();\r\n                                                       $(\"#b_get_arh_dossier\").hide();\r\n                                                       $(\"#b_upd_return_date\").hide();\r\n                                                       $(\"#b_add\").show();\r\n                                                       $(\"#dossier_info\").empty();\r\n                                                       $(\"#document_info\").empty();\r\n                                                       $(\"#dossier_load\").show();\r\n                                                       $.ajax({\r\n                                                               url:\"pkg_w_e_dossier.p_dossier_info\",\r\n                                                               type:\"POST\",\r\n                                                               data:{p_pcust_shortname : $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n                                                                     p_dossier         : $(\"#h_pdossier\").val(),\r\n                                                                     p_access          : $(\"#n_access\").val(),\r\n                                                                     p_arh_status      : 1,\r\n                                                                     p_sloan_agreement : $(\"#r_sloan_agreement\") ? $(\"#r_sloan_agreement\").val() : \"\"\r\n                                                                     },\r\n                                                               success:function(data)\r\n                                                                       {\r\n                                                                        $(\"#dossier_load\").hide();\r\n                                                                        $(\"#dossier_info\").append(data);\r\n                                                                        $(\"#dossier_on\").css(\"color\",\"black\");\r\n                                                                        $(\"#dossier_off\").css(\"color\",\"#778899\");\r\n                                                                       },error: function(xhr, status, error){\r\n                                                                                   var errorMessage = xhr.status + \": \" + xhr.statusText + \": \"+xhr.responseText;\r\n                                                                                   alert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n                                                                                    $(\"#dossier_load\").hide();\r\n                                                                                    $(\"#dossier_on\").css(\"color\",\"black\");\r\n                                                                                    $(\"#dossier_off\").css(\"color\",\"#778899\");\r\n                                                                              }\r\n                                                               });\r\n                                                       }\r\n                                                      };\r\n   /*------------------Добавление нового документа------------------*/\r\n                       function fail_doc_new_add_dial2()\r\n                                                     {\r\n                                                      var params = \"width=420,height=680,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_doc_new_add_dial2?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n               +\"&p_ssection=\"+$(\"select[name=p_section]\").val()\r\n               +\"&p_scust_shortname=\"+$(\"input[name=r_pcust_shortname]:checked\").val()\r\n                                                      +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_doc_new_add_dial2\", params);\r\n                                                     };\r\n           function f_doc_add_dial2()\r\n                                                     {\r\n                                                      var params = \"width=420,height=420,menubar=no,location=no,resizable=yes,scrollbars=yes,status=no,modal=yes\";\r\n                                                      var s_url = \"pkg_w_e_dossier.p_doc_new_add_dial2?p_dossier=\"+$(\"#h_p_dossier\").val()\r\n               +\"&p_ssection=\"+$(\"input[name=r_parchitecture]:checked\").val()\r\n               +\"&p_scust_shortname=\"+$(\"input[name=r_pcust_shortname]:checked\").val()\r\n                                                      +\"&p_access=\"+$(\"#n_access\").val();\r\n                                                      win=window.open(s_url, \"p_doc_new_add_dial2\", params);\r\n                                                     };\r\n                   </script>\n<body bgcolor=\"#A2B5CD\" id=\"body_id\">\n<center>\n<div id=\"accordion\" width=\"98%\" onClick=\"ReSize()\">\n<h3>Поиск заемщика</h3>\n<div id=\"cust_search\">\n<table  border=0 cellspacing=0 align=\"center\" width=\"100%\">\n<tr>\n<td style=\"width:50%\">\n<div id=\"cust_filter\">\n<table  border=0 cellspacing=0 align=\"left\" width=\"80%\">\n<tr>\n<td>ФИО/Наименование клиента</td>\n<td><input type=\"text\" id=\"t_cust_shortname\"></td>\n<td>№ досье:</td>\n<td><input type=\"text\" id=\"t_dossier_number\"></td>\n</tr>\n<tr>\n<td>ИИН/БИН</td>\n<td><input type=\"text\" id=\"t_iin_bin\"></td>\n<td>Референс досье:</td>\n<td><input type=\"text\" id=\"t_sloan_agreement\"></td>\n</tr>\n<tr>\n<td>Ключ клиента</td>\n<td><input type=\"text\" id=\"t_pcust_shortname\"></td>\n</tr>\n<tr align=\"center\">\n<td colspan=4>&nbsp;</td>\n</tr>\n<tr align=\"center\">\n<td colspan=4><input type=\"button\" value=\"Найти\" id=\"bt_search\"  onClick=\"f_cust_search('search')\"><input type=\"button\" id=\"bt_clear\" value=\"Очистить\" onClick=\"f_input_clear()\"></td>\n</tr>\n</table>\n</div>\n<br />\n</td>\n<input type=\"hidden\