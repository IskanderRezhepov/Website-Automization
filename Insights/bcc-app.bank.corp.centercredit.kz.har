            "text": "<meta http-equiv=\"X-UA-Compatible\" content=\"chrome=1\">\n<html>\n<!-- n_access_1-0 -->\n<!-- n_access_2-0 -->\n<!-- n_access_3-0 -->\n<!-- n_access_4-1 -->\n<!-- n_access_5-0 -->\n<!-- n_access_6-0 -->\n<!-- n_access_7-0 -->\n<!-- n_access_8-0 -->\n<!-- n_access_9-0 -->\n<input type=\"hidden\" id=\"n_access\" name=\"n_access\" value=\"3\">\n<head>\n <SCRIPT LANGUAGE=\"JavaScript\" src=\"/common/js/menuview_ie.js\"></script>\n<br />\n<meta http-equiv=\"Content-Style-Type\" name=\"Bank\" content=\"text/css\">\n<link rel=\"STYLESHEET\" href=\"/wrbhq/css/report.css\">\n<!--p_css=/wrbhq/css/report.css -->\n<script language=\"JavaScript\" src=\"/common/js/menuview_ie.js\"></script>\n<SCRIPT LANGUAGE=\"JavaScript\" src=\"/wrbhq/js/jslib1.js\"></script>\n<script language=\"JavaScript\">\n\n    if (1==1) {\n      MenuFontColor = \"#ffffff\";\n      MenuBgColor = \"#006655\";\n      MenuActivColor = \"white\";\n      MenuActivBgcolor = \"#569974\";\n      topMenuBgColor = \"#eace7e\";\n      topMenuFontColor = \"#006655\";\n      topMenuActivColor = \"#006655\";\n      topMenuActivBgcolor = \"#f0bf00\";\n      imgLogo = \"/wrbhq/img/logo.gif\";\n      winwidth = 790;\n      winheight = 542;\nmain_page = \"/ecd/pkg_w_e_start_page.start_page\";\n      addMenu(\"Menu2\", \"Сотрудник ГО\",\"Сотрудник ГО\", \"\",\"\");\n<!-- =>>>>>CBS25A9F2F0536520E21BE53CAD7B5 -->\n<!-- <=====ED101 -->\naddSubMenu(\"Menu2\", \"Главная форма (Просмотр)\", \"\",\"pkg_w_e_dossier.p_main?p_arm=CBS25A9F2F0536520E21BE53CAD7B5\", \"\", \"\", \"\", \"CBS25A9F2F0536520E21BE53CAD7B5\");\n<!-- =>>>>>CBS25A9F2F0536520E21BE53CAD7B5 -->\n<!-- <=====ED101 -->\naddSubMenu(\"Menu2\", \"Отчёт по изъятым документам/досье из кладовой кассы\", \"\",\"pkg_w_e_dossier_output.p_main?p_arm=CBS25A9F2F0536520E21BE53CAD7B5\", \"\", \"\", \"\", \"CBS25A9F2F0536520E21BE53CAD7B5\");\n<!-- =>>>>>CBS25A9F2F0536520E21BE53CAD7B5 -->\n<!-- <=====ED101 -->\naddSubMenu(\"Menu2\", \"Отчёт по договорам займа с п