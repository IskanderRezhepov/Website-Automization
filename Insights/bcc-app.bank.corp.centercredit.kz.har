    a = document.cookie.split(\";\");\n    document.cookie=a[0]+\"; expires=\"+c.toGMTString()+\";\"\n    window.alert(document.cookie);\n    }\naddMenu(\"Menu5\", \"?\", \"\",\"\",\"right\");\naddSubMenu(\"Menu5\", \"Подсказка АРМа\", \"\", \"\", \"\", \"\", \"\", \"\");\ndrawToolbar();\n}\n</script>\n <SCRIPT LANGUAGE=\"JavaScript\" src=\"/wrbhq/js/jslib1.js\"></SCRIPT>\n <SCRIPT LANGUAGE=\"JavaScript\" src=\"/wrbhq/js/calendar.js\"></SCRIPT>\n<br />\n<center>\n<font color=\"#g0r0b0\" face=\"Times New Roman\">\n<link type=\"text/css\" href=\"/wrbhq/css/report.css\" rel=\"stylesheet\" />\n<META http-equiv=\"expires\" content=\"Mon, 01 Jan 1990 00:00:00 GMT\">\n           <META http-equiv=\"Content-Type\" content=\"text/html; charset=windows-1251\">\n<b align=\"center\" width=\"99%\" valign=\"middle\">Электронное кредитное досье. KOMSABAM - Просмотр.</b>\n</font>\n</center>\n</head>\n<hr />\n<br />\n<title>\"Электронное кредитное досье\"</title>\n<link type=\"text/css\" href=\"/wrbhq/js/jquery/plugins/jquery.ui/css/cm-green-theme/jquery-ui-1.8.23.custom(ECD).css\" rel=\"stylesheet\" />\n<script type=\"text/javascript\" src=\"/wrbhq/js/jquery/jquery-1.6.1.min.js\"></script>\n<script type=\"text/javascript\" src=\"/cr/js/collector/jquery-ui-1.9.1.custom.min.js\"></script>\n<script type=\"text/javascript\" src=\"/wrbhq/js/uri.utf8_cp1251_kz.fix.js\"></script>\n<script type=\"text/javascript\" src=\"/wrbhq/js/jquery/plugins/jquery.ui/jquery.jqGrid.min.js\"></script>\n<script type=\"text/javascript\" src=\"/wrbhq/js/jquery/plugins/jquery.ui/css/cm-green-theme/jquery.form.js\"></script>\n<script type=\"text/javascript\" src=\"/wrbhq/js/jquery/plugins/jquery.maskedinput.min.js\"></script>\n<style> td.on   {background: #DCDCDC; cursor: crosshair}\r\n                        td.off  {background: white}\r\n                        tr.onCL_1 td {font-weight: bold; font-style : italic;  cursor: hand}\r\n                        tr.onCL_2 td {font-weight: bold;font-style : italic; 