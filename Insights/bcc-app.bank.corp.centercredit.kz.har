            "mimeType": "application/x-javascript",
            "text": "// 21.04.2020, Gabit Omarov\r\nfunction formclear(doc,cform) {\r\n  obj=eval(doc+\".\"+cform);\r\n  if (obj!=null){\r\n   for (i=0; i<obj.length; i++) {\r\n    if ((obj[i].name.toUpperCase()!=\"P_ACTION\")&&(obj[i].name.toUpperCase()!=\"P_DC\")) {obj[i].value=\"\"; p_type=obj[i].type; if (p_type.toUpperCase()==\"CHECKBOX\") {obj[i].checked=false}}}}\r\n}\r\n\r\nfunction buttonclick(cdoc,cform,cbutton) {\r\n eval(cdoc+\".\"+cform+\".\"+cbutton+\".click()\");\r\n}\r\n\r\nfunction nround(vl,k) {nk=1; for (i=1; i<k+1; i++) {nk=nk*10;}\r\n  n_vl = vl*nk; n_vl=Math.round(n_vl); n_vl = n_vl/nk;\r\n  return n_vl;\r\n}\r\n\r\nfunction nreplace(str,v1,v2){\r\n pp=0; nstr=str;\r\n while (pp!=-1) {pp=nstr.indexOf(v1);\r\n  if (pp!=-1) {\r\n    nstr=nstr.replace(v1,v2);}\r\n } return nstr;\r\n}\r\n\r\nfunction datechek(idfield) {\r\n  obj=document.getElementById(idfield);\r\n  dd = obj.value; dd=nreplace(dd,\" \",\"\");obj.value=dd; if ((dd==null)||(dd==\"\")) {return true;}\r\n  dd = nreplace(dd,\"-\",\"\");dd = nreplace(dd,\"/\",\"\");dd = nreplace(dd,\"\\\\\",\"\");dd = nreplace(dd,\".\",\"\");dd = nreplace(dd,\",\",\"\");dd = nreplace(dd,\"*\",\"\");dd = nreplace(dd,\":\",\"\");\r\n  dtype = parseInt(dd*1); if (isNaN(dtype)) {alert(\"Неверный формат даты.\"); obj.value=\"\"; obj.focus(); return false;}\r\n  dd = obj.value;\r\n  dd = nreplace(dd,\"/\",\"-\");dd = nreplace(dd,\"\\\\\",\"-\");dd = nreplace(dd,\".\",\"-\");dd = nreplace(dd,\",\",\"-\");dd = nreplace(dd,\"*\",\"-\");dd = nreplace(dd,\":\",\"-\");\r\n  obj.value =dd;\r\n  pos=dd.indexOf(\"-\"); if (pos!=-1) {d=dd.substr(0,pos); dd=dd.substr(pos+1);} else {d=dd; dd=\"\";} if ((d<1)||(d>31)) {alert(\"Неверный день\"); obj.value=\"\"; obj.focus(); return false;}\r\n  pos=dd.indexOf(\"-\"); if (pos!=-1) {m=dd.substr(0,pos); dd=dd.substr(pos+1);} else {m=dd; dd=\"\";} if ((m<1)||(m>12)) {alert(\"Неверный месяц\"); obj.value=\"\"; obj.focus(); return false;}\r\n  pos=dd.indexOf(\"-\"); if (pos!=-1) {y=dd.substr(0,pos); dd=dd.substr(pos+1);} else {y=dd; dd=\"\";} if ((y<1900)||(y>3000)) {alert(\"Неверный год\"); obj.value=\"\"; obj.focus(); return false;}\r\n  if((m==2)&&(d>29)) {alert(\"Неверный день\"); obj.value=\"\"; obj.focus(); return false;}\r\n  obj.value=d+\"-\"+m+\"-\"+y;\r\n  return true;}\r\n\r\nfunction numchek(idfield,tf,fr) {\r\n  if((tf==\"yes\")||(tf==null)||(tf==\"\")) {tfstatus=true;} else {tfstatus=false;}\r\n  //obj=eval(cdoc+\".all[\"+si+\"]\");\r\n  obj=document.getElementById(idfield);\r\n  nn=obj.value.replace(\",\",\".\");\r\n  if((fr!=\"\")&&(fr!=null)){nn1=nround(nn,fr); if(nn1!=nn){return false;}}\r\n  obj.value=nn;\r\n  nn_v=parseInt(nn*1); if (isNaN(nn_v)) {return false;}\r\n  if((tfstatus)&&((nn_v==null)||(nn_v==\"\")||(nn_v==0))) {return false;}\r\n  return true;}\r\n\r\nfunction integerchek(cdoc,si,tf) {\r\n  if((tf==\"yes\")||(tf==null)||(tf==\"\")) {itfstatus=true;} else {itfstatus=false;}\r\n  obj=eval(cdoc+\".all[\"+si+\"]\");\r\n  nn=obj.value.replace(\".\",\"q\");\r\n  nn_v=parseInt(nn*1); if (isNaN(nn_v)) {obj.focus(); alert(\"Неверно введены данные.\");return false;}\r\n  if((itfstatus)&&((nn_v==null)||(nn_v==\"\")||(nn_v==0))) {obj.focus(); alert(\"Неверно введены данные.(пустое или нулевое значение)\");return false;}\r\n  return true;}\r\n\r\nfunction StrCurrDate()\r\n{now = new Date();\r\n CurYear = now.getYear();\r\n CurMonth = now.getMonth();\r\n CurDate = now.getDate();\r\n CurHour = now.getHours();\r\n CurMinute = now.getMinutes();\r\n CurSecond = now.getSeconds();\r\n strDate = \"D\"+CurYear+CurMonth+CurDate+CurHour+CurMinute+CurSecond;\r\n return strDate;\r\n}\r\n\r\nfunction rnnchek(cdoc,si,tf){\r\n  if((tf==\"yes\")||(tf==null)||(tf==\"\")) {tfstatus=true;} else {tfstatus=false;}\r\n  obj=eval(cdoc+\".all[\"+si+\"]\");\r\n  nn=obj.value; nn=nreplace(nn,\" \",\"\"); obj.value=nn;\r\n  if (nn.length!=12){return false;}\r\n  nn=parseInt(nn*1);if (isNaN(nn)){return false;}\r\n  if((tfstatus)&&((nn==null)||(nn==\"