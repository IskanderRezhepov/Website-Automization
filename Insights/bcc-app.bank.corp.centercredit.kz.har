n\tif ($(\"input[name=r_parchitecture]:checked\").val() == null) { alert(\"Выберите документ\"); }\r\n\telse {\r\n\t\tvar a = $(\"#p_pdos_document\").val();\r\n\t\tvar action_code = $(\"#h_action_\" + a + \"\").val();\r\n\t\tvar status_code = $(\"#h_status_\" + a + \"\").val();\r\n\t\tif (action_code == 2 && status_code == 3) {\r\n\t\t\tif (confirm(\"Отправить документ в архив?\")) {\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: \"pkg_w_e_dossier.p_action\",\r\n\t\t\t\t\ttype: \"POST\",\r\n\t\t\t\t\tdata: {\r\n\t\t\t\t\t\tp_dossier: $(\"#p_dossier\").val(),\r\n\t\t\t\t\t\tp_pdos_document: $(\"#p_pdos_document\").val(),\r\n\t\t\t\t\t\tp_code: 14,\r\n\t\t\t\t\t\tp_parchitecture: $(\"input[name=r_parchitecture]:checked\").val()\r\n\t\t\t\t\t},\r\n\t\t\t\t\tsuccess: function (data) {\r\n\t\t\t\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t\t\t\tdocument_show_2();\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\telse {\r\n\t\t\talert(\"Перед запуском «отправка документа  в архив» документ следует изъять  из спецхранилища!\");\r\n\t\t};\r\n\t}\r\n};\r\n/*--------Фокус главного окна после добавления документа------*/\r\nfunction f_focus() {\r\n\t$(document).focus();\r\n\t$(window).focus();\r\n};\r\n\r\n/*--------------Очень важная функция НЕ ТРОГАТЬ!!!!!----------*/\r\n\r\nfunction f_pdos_document_ch(id) {\r\n\t$(\"#p_pdos_document\").val(id);\r\n\t$(\"#p_pdos_document_cut\").val(id);\r\n\t$(\"#p_pdos_document_cut_acc\").val(id);\r\n\t$(\"#p_pdos_document_cut_return\").val(id);\r\n\t$(\"#p_parchitecture\").val($(\"input[name=r_parchitecture]:checked\").val());\r\n};\r\n/*----------------Мультиплицированное добавление в добавленом досье------------*/\r\n\r\nfunction f_multiplic(id) {\r\n\tif ($(\"#h_dossier_status\").val() == 3) {\r\n\t\talert(\"Невозможно добавить документ. Досье изъято!\");\r\n\t}\r\n\telse {\r\n\t\tif (id == \"2259\" || id == \"2260\" || id == \"2261\" || id == \"2262\" || id == \"2263\"\r\n\t\t\t|| id == \"2264\" || id == \"2265\" || id == \"2266\" 