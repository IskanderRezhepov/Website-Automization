\n\tif ($(\"input[name=r_parchitecture]:checked\").val() == null) { alert(\"Выберите документ\"); }\r\n\telse {\r\n\t\tvar a = $(\"#p_pdos_document\").val();\r\n\r\n\t\tvar action_code = $(\"#h_action_\" + a + \"\").val();\r\n\t\tvar status_code = $(\"#h_status_\" + a + \"\").val();\r\n\t\tvar n_status = $(\"#h_n_status_\" + a + \"\").val();\r\n\t\tvar n_dossier_status = $(\"#h_status\").val();\r\n\t\tif (((action_code == 7) && ($(\"#p_sdossier_type\").val() != 27)) ||\r\n\t\t\t(action_code == 1 & status_code == 1) || (action_code == 11 & status_code == 1) ||\r\n\t\t\t($(\"#p_sdossier_type\").val() == 7 || $(\"#p_sdossier_type\").val() == 21 || $(\"#p_sdossier_type\").val() == 24) ||\r\n\t\t\t(action_code == 5 & status_code == 1 & n_status == 1) || ((action_code == 4 || action_code == 3) && status_code == 1 && n_dossier_status == 12) || ((action_code == 4 || action_code == 3) && status_code == 1 && $(\"#p_sdossier_type\").val() == 27)) {\r\n\t\t\t$.post(\"pkg_w_e_dossier.p_upd_dial\",\r\n\t\t\t\t{\r\n\t\t\t\t\tp_pdos_document: $(\"#p_pdos_document\").val()\r\n\t\t\t\t}).done(function (data) {\r\n\t\t\t\t\t$(\"#doc_upd\").html($(data).html());\r\n\t\t\t\t});\r\n\t\t\t$(\"#fail_doc_upd\").dialog(\"open\");\r\n\t\t}\r\n\t\telse {\r\n\t\t\talert(\"Невозможно редактирование при данном действии  и статусе документа\");\r\n\t\t}\r\n\t}\r\n\r\n};\r\nfunction f_chng_count_upd(obj) {\r\n\tif (obj.checked) {\r\n\t\t$(\"input[name=p_count_paper_upd]\").val(0);\r\n\t} else {\r\n\t\t$(\"input[name=p_count_paper_upd]\").val(1);\r\n\t}\r\n};\r\n$(\"#fail_doc_upd\").dialog({\r\n\tautoOpen: false,\r\n\theight: 400,\r\n\twidth: 500,\r\n\tparentBlock: $(\"#fail_doc_upd\").parent(),\r\n\tmodal: true,\r\n\tresizeble: false,\r\n\tbuttons: {\r\n\t\t\"Редактировать\": function () {\r\n\t\t\tif (confirm(\"Редактировать документ?\")) {\r\n\t\t\t\tif (\r\n\t\t\t\t\t$(\"#p_count_paper_upd\").val() == \"\" ||\r\n\t\t\t\t\t($(\"#p_count_paper_upd\").val() == 0 && $(\"#p_chk_elec_form_upd\").prop(