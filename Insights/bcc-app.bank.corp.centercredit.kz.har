\";cursor:default;width:100%;height:100%;padding:1' \";\r\n   else\t\r\n\t\tTempStr = \"<div ID='\" +ID_SM+ \"' TITLE='\" +SubMenuHelpStr+ \"' STYLE='text-align:left; text-decoration:none; background:\" +MenuBgColor+ \";color:\"+MenuFontColor+\";font:\"+MenuFont+\";cursor:default;width:100%;height:100%;padding:1' \";\r\n\r\n   if (!NeWindow){NeWindow = false;}\r\n   if (SubMenuURLStr != \"\") {TempStr += \" onclick= ' ArmSet(ArmCodeParm,\\\"\"+s_ArmCode+\"\\\",\\\"\"+SubMenuURLStr+\"\\\"); doaddres(\" + C34 + SubMenuURLStr +C34+ \",\" +C34+ SubMenuStr +C34+\",\"+C34+TargetStr+C34+\",\"+NeWindow+\")'\"}\r\n   if (ie==1)\r\n\t\tTempStr += \" onmouseout=\" +C34+ \"mouseMenu('out' ,'\" + ID_SM + \"')\" +C34+ \" onmouseover=\" +C34+ \"mouseMenu('over','\" + ID_SM + \"')\" +C34+ \"><div style='width:100%;height:100%;'>&nbsp;\"+SubMenuStr+\"&nbsp;</div></A>\"\r\n   else\r\n\t\tTempStr += \" onmouseout=\" +C34+ \"mouseMenu('out' ,'\" + ID_SM + \"')\" +C34+ \" onmouseover=\" +C34+ \"mouseMenu('over','\" + ID_SM + \"')\" +C34+ \">&nbsp;\"+SubMenuStr+\"&nbsp;</div>\"\r\n\r\n   if (!NeWindow){NeWindow = false;}\r\n   if (appver>4) {TempStr += \"<br>\";}\r\n }\r\n else //РµСЃР»Рё СЌС‚Рѕ РЅРµ РїРѕСЃР»РµРґРЅРёР№ СѓСЂРѕРІРµРЅСЊ\r\n { TotalSubSubMenu = 0;\r\n   TempStr = \"<TABLE valign=\"+C34+ \"bottom\"+C34+ \" border=0 cellpadding=0 cellspacing=0 nowrap=\"+C34+ \"yes\" +C34+\" ID='\" +ID_SM+ \"' TITLE='\" +SubMenuHelpStr+ \"' STYLE='float:right;text-decoration:none; background:\" +MenuBgColor+ \";color:\"+MenuFontColor+\";font:\"+MenuFont+\";cursor:default;width:100%;padding:1' \";\r\n   if (!NeWindow){NeWindow = false;}\r\n   if (SubMenuURLStr != \"\") {TempStr += \" onclick='doaddres(\" + C34 + SubMenuURLStr +C34+ \",\" +C34+ SubMenuStr +C34+\",\"+C34+TargetStr+\",\"+NeWindow+C34+\")'\"}\r\n   TempStr += \" onmouseover=\" + C34 +  \"doSubMenu('\" + MenuIDStr + \"', '\" + ID_SM + \"');mouseMenu('over' ,'\" + ID_SM + \"');\" + C34 + \" onmouseout=\" + C34 +  \"hideSubMenu('\" + \