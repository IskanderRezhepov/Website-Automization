            "text": "<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0  >\n<tr align=\"center\">\n<td width=\"1%\">&nbsp;</td>\n<td width=\"1%\">&nbsp;</td>\n<td width=\"1%\">&nbsp;</td>\n<td width=\"13%\"><b>Наименование документа</b></td>\n<td width=\"10%\"><b>Примечание</b></td>\n<td width=\"4%\"><b>Миниатюра</b></td>\n<td width=\"4%\"><b>Кол-во листов/документов</b></td>\n<td width=\"7%\"><b>Номер документа</b></td>\n<td width=\"2%\"><b>ГЭСВ</b></td>\n<td width=\"6%\"><b>Дата документа</b></td>\n<td width=\"4%\"><b>Признак копии</b></td>\n<td width=\"4%\"><b>Электронный формат</b></td>\n<td width=\"4%\"><b>Признак электронной подписи</b></td>\n<td width=\"4%\"><b>Референс</b></td>\n<td width=\"6%\"><b>Референс залога</b></td>\n<td width=\"8%\"><b>Последнее действие</b></td>\n<td width=\"8%\"><b>Статус</b></td>\n<td width=\"8%\"><b>Предыдущие версии</b></td>\n</tr>\n<tr>\n<td colspan=\"18\"><hr size=\"3\"></td>\n</tr>\n<tbody class=\"ccl\">\n<tr align=\"center\" id=\"tr_id\"      style=\"color:black\" bgcolor=\"#A2B5CD\" onClick=\"mouseClick(this)\" onDblClick=\"mouseClick(this)\">\n<input type=\"hidden\"   id=\"h_psection\" name=\"h_psection\" value=\"6\">\n<input type=\"hidden\"   id=\"h_action_27394214\" name=\"h_action_27394214\" value=\"11\" >\n<input type=\"hidden\"   id=\"h_status_27394214\" name=\"h_status_27394214\" value=\"1\" >\n<input type=\"hidden\"   id=\"h_n_status_27394214\" name=\"h_n_status_27394214\" value=\"1\" >\n<input type=\"hidden\"   id=\"h_count_paper_27394214\" name=\"h_count_paper_27394214\" value=\"0\">\n<input type=\"hidden\"   id=\"h_chk_elec_form_27394214\" name=\"h_chk_elec_form_27394214\" value=\"1\" >\n<input type=\"hidden\"   id=\"h_chk_el_sign_27394214\" name=\"h_chk_el_sign_27394214\" value=\"0\" >\n<input type=\"hidden\"   id=\"h_cut_note_27394214\" name=\"h_cut_note_27394214\" value=\"0\" >\n<input type=\"hidden\" id=\"p_chk_el_sign\" >\n<td width=\"1%\"><input type=\"checkbox\" name=\"27394214\" id=\"che