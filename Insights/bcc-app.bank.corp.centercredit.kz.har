ue;\r\n\t\t\t\t\t\t\t\tvar e = axo.getFile(d);\r\n\t\t\t\t\t\t\t\tvar f = e.size;\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\tvar f = document.doc_replace.p_file.files[0].size;\r\n\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\tif (f < 20000000) {\r\n\t\t\t\t\t\t\t\t$(\"#doc_replace\").ajaxStart(f_download(\"open\"));\r\n\t\t\t\t\t\t\t\t$(\"#doc_replace\").ajaxSubmit({\r\n\t\t\t\t\t\t\t\t\tsemantic: true,\r\n\t\t\t\t\t\t\t\t\tglobal: true,\r\n\t\t\t\t\t\t\t\t\tsuccess: function (data) {\r\n\t\t\t\t\t\t\t\t\t\t$(_this).dialog(\"close\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_count_paper_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_note_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_file_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_doc_num_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_date_start_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"input[name=p_file]\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\tdocument_show_2();\r\n\t\t\t\t\t\t\t\t\t\t$(\"#doc_replace\").ajaxStop(f_download(\"close\"));\r\n\t\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\t\terror: function (xhr, status, error) {\r\n\t\t\t\t\t\t\t\t\t\tvar errorMessage = xhr.status + \": \" + xhr.statusText + \": \" + xhr.responseText;\r\n\t\t\t\t\t\t\t\t\t\talert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n\t\t\t\t\t\t\t\t\t\t$(_this).dialog(\"close\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_count_paper_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_note_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_file_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_doc_num_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"#p_date_start_return\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\t$(\"input[name=p_file]\").val(\"\");\r\n\t\t\t\t\t\t\t\t\t\tdocument_show_2();\r\n\t\t\t\t\t\t\t\t\t\t$(\"#doc_replace\").ajaxStop(f_download(\"close\"));\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse {\r\n\t\t\t\t\t\t\t\t$(\".ui-dialog-buttonset\").show();\r\n\t\t\t\t\t\t\t\talert(