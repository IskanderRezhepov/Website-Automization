            "text": "// replace UTF-8 with WIN-1251\nwindow.encodeURIComponent = function(str_in)\n{\n  var str = str_in.toString();\n  var trans = [];\n  for (var i = 0x410; i <= 0x44F; i++) trans[i] = i - 0x350; // А-Яа-я\n  trans[0x401] = 0xA8; // Ё\n  trans[0x451] = 0xB8; // ё\n  trans[0x4D8] = 0xA3; // ?\n  trans[0x4D9] = 0xBC; // ?\n  trans[0x456] = 0xB3; // і\n  trans[0x406] = 0xB2; // І\n  trans[0x4A2] = 0xBD; // ?\n  trans[0x4A3] = 0xBE; // ?\n  trans[0x492] = 0xAA; // ?\n  trans[0x493] = 0xBA; // ?\n  trans[0x4AE] = 0xAF; // ?\n  trans[0x4AF] = 0xBF; // ?\n  trans[0x4B0] = 0xA1; // ?\n  trans[0x4B1] = 0xA2; // ?\n  trans[0x49A] = 0x8D; // ?\n  trans[0x49B] = 0x9D; // ?\n  trans[0x4BA] = 0x8E; // ?\n  trans[0x4BB] = 0x9E; // ?\n  trans[0x4E8] = 0xA5; // ?\n  trans[0x4E9] = 0xB4; // ?\n  var ret = [];\n  for (var i = 0; i < str.length; i++){\n    var n = str.charCodeAt(i);\n    if (typeof trans[n] != 'undefined') n = trans[n];\n    if (n <= 0xFF) ret.push(n);\n  }\n  return escape(String.fromCharCode.apply(null, ret)).replace(/\\+/g, '%2B'); // +\n}"
