            "text": "<script type=\"text/javascript\" src=\"/wrbhq/js/p_document_info.js\"></script>\n<script language='JavaScript'>$(document).ready(function(){\r\n/*---------Принять досье архивариусом--------------*/\r\n function f_storage_place_change(){\r\n                    if (($(\"select[name=p_storage_place]\").val() == 1) )\r\n                        {\r\n                             $(\"#p_stillage\").hide();\r\n                             $(\"#p_board\").hide();\r\n                             $(\"#p_serial_number\").hide();\r\n                                 } else\r\n                        if (($(\"select[name=p_storage_place]\").val() == 2) )\r\n                            {\r\n                              $(\"#p_stillage\").show();\r\n                              $(\"#p_board\").show();\r\n                              $(\"#p_serial_number\").show();\r\n                                                                };\r\n                                              }\r\n           // Отключение функциональных кнопок для мигрированного в ЦЭА досье\r\n         function f_check_dos_state(){\r\n           n_dossier_state = $(\"#h_status\").val();\r\n           if(n_dossier_state==\"15\"){\r\n            $(\":button\").prop(\"disabled\",true);\r\n            $(\"#bt_search\").prop(\"disabled\",false);\r\n            $(\"#bt_clear\").prop(\"disabled\",false);\r\n            }else{\r\n            $(\":button\").prop(\"disabled\",false);\r\n            }\r\n         }\r\n         f_check_dos_state();\r\n/*---------Докладчик ФИО--------------*/\r\n                     $('#b_add_manager').click(function(){\r\n                                f_open_new();\r\n                             });\r\n                     $('#b_add_manager_dossier').click(function(){\r\n                                f_open_new();\r\n                             });\r\n  //----------------------Страница поиска нового сотрудника\r\n                         function f_open_new(){\r\n                           //var n_arm_self_esteem_id=$(\"input[name='p_arm_self_esteem_id']\").val();\r\n                           //alert($(\"#p_return_date\").val());\r\n                       var features =\"toolbar=1,location=1,directories=1,status=1,menubar=1,center,scrollbars=1,resizable=1,copyhistory=0,height=2050,width=3050,left=0,top=0\";\r\n                        s_url=\"/ecd/pkg_w_e_dossier.p_docladchik\";\r\n                        //w_ed=window.showModalDialog(s_url,null,features);\r\n                        w_ed=window.open(s_url,null,features);\r\n                        //alert(\"p_arm_self_esteem_id: \"+n_arm_self_esteem_id);\r\n                        };\r\n  $(\"#p_aer\").hide();$(\"#ddd\").text(\"\");\r\n  $('.parent').click(function() {\r\n     n_section_id=$(this).attr('section');\r\n     n_parchitecture=$(this).attr('parchitecture');\r\n     n_arch_status=\"\";\r\n     n_access=3;\r\n     n_user_cnt=0;\r\n     n_sdossier=2216027;\r\n     n_centerproject_write=0;\r\n    $.post('PKG_W_E_DOSSIER.P_DOCUMENT_INFO_DETAIL',\r\n      {p_dossier : n_sdossier,\r\n       p_section : n_section_id,\r\n       p_access  : n_access,\r\n       p_architecture : n_parchitecture,\r\n       p_arh_status : n_arch_status,\r\n       p_user_cnt :  n_user_cnt,\r\n       p_centerproject_write : n_centerproject_write\r\n      }, function(data){\r\n         $(\"#dv_\"+n_parchitecture+\" \").html(data);\r\n         $(\"#dv_\"+n_parchitecture+\" \").slideToggle();\r\n      });\r\n});\r\n$(\"#in_ssection\").change(function(){\r\nif( $(\"#in_ssection\").val() == \"2288\" || $(\"#in_ssection\").val()==\"2289\" || $(\"#in_ssection\").val()==\"2290\"\r\n|| $(\"#in_ssection\").val()==\"2291\"|| $(\"#in_ssection\").val()==\"2292\"|| $(\"#in_ssection\").val()==\"2259\"|| $(\"#in_ssection\").val()==\"2260\"|| $(\"#in_ssection\").val()==\"2261\"\r\n|| $(\"#in_ssection\").val()==\"2266\"|| $(\"#in_ssection\").val()==\"2262\"|| $(\"#in_ssection\").val()==\"2263\"|| $(\"#in_ssection\").val()==\"2264\"|| $(\"#in_ssection\").val()==\"2265\"\r\n|| $(\"#in_ssection\").val()==\"2267\"|| $(\"#in_ssection\").val()==\"2268\"|| $(\"#in_ssection\").val()==\"2269\"|| $(\"#in_ssection\").val()==\"2270\"|| $(\"#in_ssection\").val()==\"2271\"\r\n|| $(\"#in_ssection\").val()==\"2272\"|| $(\"#in_ssection\").val()==\"2273\"|| $(\"#in_ssection\").val()==\"2274\"|| $(\"#in_ssection\").val()==\"2275\"|| $(\"#in_ssection\").val()==\"2276\"\r\n|| $(\"#in_ssection\").val()==\"2277\"|| $(\"#in_ssection\").val()==\"2278\"|| $(\"#in_ssection\").val()==\"2279\"|| $(\"#in_ssection\").val()==\"2280\"|| $(\"#in_ssection\").val()==\"2281\"\r\n|| $(\"#in_ssection\").val()==\"2282\"|| $(\"#in_ssection\").val()==\"2283\"|| $(\"#in_ssection\").val()==\"2284\"|| $(\"#in_ssection\").val()==\"2285\"|| $(\"#in_ssection\").val()==\"2286\"\r\n|| $(\"#in_ssection\").val()==\"2287\"|| $(\"#in_ssection\").val()==\"2336\"|| $(\"#in_ssection\").val()==\"2478\")\r\n                                 {\r\n                                            $(\"#ddd\").text(\"* Значение ставки ГЭСВ НБ\");\r\n                                            $(\"#p_aer\").show();\r\n                                           }\r\n                   else{\r\n                                            $(\"#p_aer\").hide();\r\n                                            $(\"#ddd\").text(\"\");\r\n                                            }\r\n                                 if(\r\n(($(\"#in_ssection\").val() == \"605\" || $(\"#in_ssection\").val()==\"308\"  || $(\"#in_ssection\").val()==\"1184\" || $(\"#in_ssection\").val()==\"2414\"\r\n|| $(\"#in_ssection\").val()==\"968\"|| $(\"#in_ssection\").val()==\"1038\"|| $(\"#in_ssection\").val()==\"201\"|| $(\"#in_ssection\").val()==\"652\"\r\n|| $(\"#in_ssection\").val()==\"1923\" || $(\"#in_ssection\").val()==\"1515\"|| $(\"#in_ssection\").val()==\"1620\"|| $(\"#in_ssection\").val()==\"1755\"\r\n|| $(\"#in_ssection\").val()==\"1184\"|| $(\"#in_ssection\").val()==\"95\" || $(\"#in_ssection\").val()==\"2451\"|| $(\"#in_ssection\").val()==\"630\"\r\n|| $(\"#in_ssection\").val()==\"623\"|| $(\"#in_ssection\").val()==\"409\"|| $(\"#in_ssection\").val()==\"507\"|| $(\"#in_ssection\").val()==\"1860\"\r\n|| $(\"#in_ssection\").val()==\"1505\"|| $(\"#in_ssection\").val()==\"1635\"|| $(\"#in_ssection\").val()==\"1757\"|| $(\"#in_ssection\").val()==\"1811\"\r\n|| $(\"#in_ssection\").val()==\"2241\"|| $(\"#in_ssection\").val()==\"2201\"|| $(\"#in_ssection\").val()==\"2202\"))\r\n)\r\n                                 {\r\n                                     alert($(\"#in_ssection\").val());\r\n                                     alert($(\"input[name=h_dossier_type]\").val());\r\n                                     $(\"#ref_m\").text(\"* Референс залога\");\r\n                                     $(\"#ref_list\").css(\"display\",\"block\");\r\n                                     $.post(\"pkg_w_e_dossier.p_reference1\",\r\n                                                                         {\r\n                                                                        p_scust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val()//\"00672854\"\r\n                                                                         }).done(function(data){\r\n                                                                                    //alert(data);\r\n                                                                                    //$(\"#p_sloan_agreement9\").html($(data).html());\r\n                                                                                    $(\"select[name='p_reference']\").html(data);\r\n                                                                                   });\r\n                                 }\r\n                  else{\r\n                           $(\"#ref_m\").text(\"\");\r\n                           $(\"#ref_list\").css(\"display\",\"none\");\r\n                           //alert($(\"#in_ssection\").val());\r\n                           //alert($(\"input[name=h_dossier_type]\").val());\r\n                           $.post(\"pkg_w_e_dossier.p_reference\",\r\n                                                                 {\r\n                                                                   p_scust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val()//\"00672854\"\r\n                                                                   }).done(function(data){\r\n                                                                     //alert(data);\r\n                                                                     //$(\"#p_sloan_agreement9\").html($(data).html());\r\n                                                                     $(\"select[name='p_reference']\").html(data);\r\n                                                                                   });\r\n                                 }\r\n                                            });\r\n                                       });\r\n      </script>\n<script>\r\n   /*---------Изъятие документа--------------*/\r\n   $(function (){\r\n                 $(\"input[name=p_return_date]\").mask(\"99-99-9999\");\r\n                 $(\"input[name=p_return_date_dossier]\").mask(\"99-99-9999\");\r\n                 });\r\n function f_type_cut_note(){\r\n                    if (($(\"select[name=p_pcut_note]\").val() == 8) || ($(\"select[name=p_pcut_note]\").val() == 1) || ($(\"select[name=p_pcut_note]\").val() == 7) || ($(\"select[name=p_pcut_note]\").val() == 9) || ($(\"select[name=p_pcut_note]\").val() == 10) )\r\n                        {\r\n                             //$(\"#p_return_date\").hide();\r\n                             $(\"#p_return_date\").attr('disabled','disabled');\r\n                                 } else\r\n                          if (($(\"select[name=p_pcut_note]\").val() != 8) && ($(\"select[name=p_pcut_note]\").val() != 1) && ($(\"select[name=p_pcut_note]\").val() != 7) && ($(\"select[name=p_pcut_note]\").val() != 9) && ($(\"select[name=p_pcut_note]\").val() != 10) )\r\n                              {\r\n                                //$(\"#p_return_date\").show();\r\n                                $(\"#p_return_date\").removeAttr('disabled');\r\n                                                                  };\r\n                                                }\r\n   /*---------Изъятие документа из подотчёта--------------*/\r\n   $(function (){\r\n                 $(\"input[name=p_return_date3]\").mask(\"99-99-9999\");\r\n                 });\r\n function f_type_cut_note3(){\r\n                    if (($(\"select[name=p_pcut_note3]\").val() == 8) || ($(\"select[name=p_pcut_note3]\").val() == 1) || ($(\"select[name=p_pcut_note3]\").val() == 7) || ($(\"select[name=p_pcut_note3]\").val() == 9) || ($(\"select[name=p_pcut_note3]\").val() == 10) )\r\n                        {\r\n                             //$(\"#p_return_date\").hide();\r\n                             $(\"#p_return_date3\").attr('disabled','disabled');\r\n                                 } else\r\n                          if (($(\"select[name=p_pcut_note3]\").val() != 8) && ($(\"select[name=p_pcut_note3]\").val() != 1) && ($(\"select[name=p_pcut_note3]\").val() != 7) && ($(\"select[name=p_pcut_note3]\").val() != 9) && ($(\"select[name=p_pcut_note3]\").val() != 10) )\r\n                              {\r\n                                //$(\"#p_return_date\").show();\r\n                                $(\"#p_return_date3\").removeAttr('disabled');\r\n                                                                  };\r\n                                                }\r\n                /*-----------------------Просмотр файлов----------------------*/\r\n                function f_look_document(id,name){\r\n                                                  var a = id;\r\n                                                  var b = name;\r\n                                                  str=\"/ecd/pkg_w_e_dossier.p_look_document?p_code_file=\"+a+\"&p_name=\"+b;\r\n                                                  //check=window.open(str,\"customer\",\"toolbar=0,location=0,directories=0,status=1,menubar=0,scrollbars=1,resizable=1,copyhistory=0,height=600,width=1000,left=0,top=0\");\r\n                                                  //check.focus();\r\n                                        window.open(str);\r\n                                        };\r\n                /*-----------------------Просмотр предыдущих версии----------------------*/\r\n                function f_look_doc_vers(id,pdossier){\r\n                                                  var a = id;\r\n                                                  var b = pdossier;\r\n                                                  str=\"/ecd/pkg_w_e_dossier.P_GET_DOCUMENT_VERSION?P_DOS_DOCUMENT=\"+a+\"&P_DOSSIER=\"+b;\r\n                                       window.open(str);\r\n                                        };\r\n                /*-Маска ввода-*/\r\n                function isNumberKey(evt){\r\n                                            var charCode = (evt.which) ? evt.which : event.keyCode\r\n                                            if (charCode > 31 && (charCode < 48 || charCode > 57))\r\n                                                return false;\r\n                                            return true;\r\n                                         };\r\n                                           </script>\n<style>\r\n         .parent {\r\n              color:  black;\r\n              cursor: pointer;\r\n              background-color: #6497B1;\r\n          }\r\n          .child {\r\n              display: none;\r\n          }\r\n          </style>\n<input type=\"hidden\" id=\"n_access\"     name=\"n_access\"     value=\"3\">\n<input type=\"hidden\" id=\"p_arh_status\" name=\"p_arh_status\" value=\"\">\n<input type=\"hidden\" id=\"sysdate\"      name=\"sysdate\"      value=\"12-08-2026\">\n<input type=\"hidden\" id=\"block_check\" name=\"block_check\" value=\"two\">\n<input type=\"hidden\" id=\"check_access\" name=\"check_access\" value=\"0\">\n<center>\n<input type=\"hidden\" id=\"h_dossier_status\" name=\"h_dossier_status\" value=\"4\">\n<input type=\"hidden\" id=\"h_dossier_type\" name=\"h_dossier_type\" value=\"36\">\n<table  border=1 width=\"98%\" cellspacing=0>\n<tr align=\"center\">\n<td align=\"center\" width=\"85%\">\n<div id=\"tabs\" style=\"width:100%\">\n<div id=\"tabs_1\" style=\"height:auto; width:auto; float:center;\">\n<ul>\n<li><a href=\"#tab_9\"><span>Переписка</span></a></li>\n<li><a href=\"#tab_1\"><span>Заявка клиента</span></a></li>\n<li><a href=\"#tab_6\"><span>Инструмент финансирования</span></a></li>\n<li><a href=\"#tab_10\"><span>Дополнительные документы</span></a></li>\n<li><a href=\"#tab_3\"><span>Финансовые данные</span></a></li>\n</ul>\n<br/>\n</div>\n<div id=\"tabs_2\">\n<center>\n<div id=\"tab_6\">\n<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0 id=\"products\">\n<tbody class=\"ccl\">\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"6\" parchitecture=\"2819\" >\n<b><ins>*Договор финансового лизинга, акты</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2819\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"6\" parchitecture=\"2821\" >\n<b><ins>Платежные поручения</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2821\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"6\" parchitecture=\"2822\" >\n<b><ins>Договор гарантии</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2822\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"6\" parchitecture=\"2823\" >\n<b><ins>График договора</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2823\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"6\" parchitecture=\"2824\" >\n<b><ins>*Договор купли-продажи, акты</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2824\"></div>\n</tbody>\n</table>\n<input type=\"hidden\" id=\"n_sum_count_paper_isp\" name=\"n_sum_count_paper_isp\" value=\"4\">\n<input type=\"hidden\" id=\"n_sum_count_paper_out\" name=\" n_sum_count_paper_out\" value=\"0\">\n<input type=\"hidden\" id=\"p_pdos_document\" name=\"p_pdos_document\">\n<br />\n<input type=\"button\" value=\"История движения документа\" OnClick=\"p_get_document_history();\">\n<input type=\"hidden\" id=\"h_pdossier\" name=\"h_pdossier\" value =\"2216027\">\n</div>\n</center>\n<center>\n<div id=\"tab_1\">\n<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0 id=\"products\">\n<tbody class=\"ccl\">\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"1\" parchitecture=\"2809\" >\n<b><ins>*Решение собрания участников Заемщика</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2809\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"1\" parchitecture=\"2810\" >\n<b><ins>*Анкета заявителя (гаранта, поручителя) </ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2810\"></div>\n</tbody>\n</table>\n<input type=\"hidden\" id=\"n_sum_count_paper_isp\" name=\"n_sum_count_paper_isp\" value=\"4\">\n<input type=\"hidden\" id=\"n_sum_count_paper_out\" name=\" n_sum_count_paper_out\" value=\"0\">\n<input type=\"hidden\" id=\"p_pdos_document\" name=\"p_pdos_document\">\n<br />\n<input type=\"button\" value=\"История движения документа\" OnClick=\"p_get_document_history();\">\n<input type=\"hidden\" id=\"h_pdossier\" name=\"h_pdossier\" value =\"2216027\">\n</div>\n</center>\n<center>\n<div id=\"tab_10\">\n<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0 id=\"products\">\n<tbody class=\"ccl\">\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"10\" parchitecture=\"2826\" >\n<b><ins>Иные документы</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2826\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"10\" parchitecture=\"2827\" >\n<b><ins>Договор страхования</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2827\"></div>\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"10\" parchitecture=\"2828\" >\n<b><ins>Договор GPS</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2828\"></div>\n</tbody>\n</table>\n<input type=\"hidden\" id=\"n_sum_count_paper_isp\" name=\"n_sum_count_paper_isp\" value=\"4\">\n<input type=\"hidden\" id=\"n_sum_count_paper_out\" name=\" n_sum_count_paper_out\" value=\"0\">\n<input type=\"hidden\" id=\"p_pdos_document\" name=\"p_pdos_document\">\n<br />\n<input type=\"button\" value=\"История движения документа\" OnClick=\"p_get_document_history();\">\n<input type=\"hidden\" id=\"h_pdossier\" name=\"h_pdossier\" value =\"2216027\">\n</div>\n</center>\n<center>\n<div id=\"tab_9\">\n<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0 id=\"products\">\n<tbody class=\"ccl\">\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"9\" parchitecture=\"2818\" >\n<b><ins>Уведомление</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2818\"></div>\n</tbody>\n</table>\n<input type=\"hidden\" id=\"n_sum_count_paper_isp\" name=\"n_sum_count_paper_isp\" value=\"4\">\n<input type=\"hidden\" id=\"n_sum_count_paper_out\" name=\" n_sum_count_paper_out\" value=\"0\">\n<input type=\"hidden\" id=\"p_pdos_document\" name=\"p_pdos_document\">\n<br />\n<input type=\"button\" value=\"История движения документа\" OnClick=\"p_get_document_history();\">\n<input type=\"hidden\" id=\"h_pdossier\" name=\"h_pdossier\" value =\"2216027\">\n</div>\n</center>\n<center>\n<div id=\"tab_3\">\n<table  border=0 bordercolor=\"#b0c4de\" width=\"95%\" cellspacing=0 id=\"products\">\n<tbody class=\"ccl\">\n<ul align=\"center\"  class=\"parent\" id=\"parent_id\" section=\"3\" parchitecture=\"2808\" >\n<b><ins>*Коммерческое предложение</ins></b>\n</ul>\n<div class=\"child\" id=\"dv_2808\"></div>\n</tbody>\n</table>\n<input type=\"hidden\" id=\"n_sum_count_paper_isp\" name=\"n_sum_count_paper_isp\" value=\"4\">\n<input type=\"hidden\" id=\"n_sum_count_paper_out\" name=\" n_sum_count_paper_out\" value=\"0\">\n<input type=\"hidden\" id=\"p_pdos_document\" name=\"p_pdos_document\">\n<br />\n<input type=\"button\" value=\"История движения документа\" OnClick=\"p_get_document_history();\">\n<input type=\"hidden\" id=\"h_pdossier\" name=\"h_pdossier\" value =\"2216027\">\n</div>\n</center>\n</div>\n</div>\n</td>\n</tr>\n</table>\n<br />\n<input type=\"hidden\" id=\"h_status_dossier\" value=\"36\">\n<center><b>Количество изъятых и/или к изъятию листов/документов:</b> 0. <b>Количество листов/документов в спецхранилище:</b> 4. <b>Количество оприходованных документов с цифровой подписью:</b> 1. <b>Место хранения:</b> СХ. <b>Стеллаж:</b> 4. <b>Полка:</b> 4. <b>Порядковый номер:</b> 1373.</center>\n<input type=\"hidden\" id=\"h_n_priority_chek\" name=\"h_n_priority_chek\" value=\"1\">\n<input type=\"hidden\" id=\"h_v_priority_chek\" name=\"h_v_priority_chek\" value=\"Не все обязательные документы добавлены - Дополнительные документы-*Нотариальное согласие супруга(-и) залогодателя / если в момент приобретения собственник в браке не состоял его нотариально удостоверенное заявление\">\n</center>\n<br />\n<div id=\"fail_doc_new_multi\" name=\"fail_doc_new_multi\" title=\"Добавление документа\">\r\n                  <form id=\"doc_new_multi\" name=\"doc_new_multi\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset align=\"center\">\r\n                        <label for=\"fail_new\">Выберите файл:</label>\r\n                        <br/>\r\n                        <input type=\"file\" name=\"p_file_new_multi\" size=\"40\" onClick=\"f_focus();\">\r\n                        <br/>\r\n                        * Кол-во листов/документов\r\n                        <br/>\r\n                        <input type=\"text\"   value=\"1\"   id=\"p_count_paper_multi\" name=\"p_count_paper_multi\" maxlength=4 onKeyPress=\"return isNumberKey(event)\">\r\n                        <br/>\r\n                        * Примечание\r\n                        <br/>\r\n                        <textarea id=\"p_note_multi\" name=\"p_note_multi\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n            <br/>\n<input type=\"hidden\" id=\"p_chk_count_paper\" value=\"1\" \n<label id = \"ddd_multi\" > * Значение ГЭСВ\r\n                             </label>\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_aer_multi\" name=\"p_aer\" maxlength=5 /*onKeyPress=\"return isNumberKey(event)*/\">\r\n                        <br/>\n* Номер документа:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_doc_num_multi\" name=\"p_doc_num_multi\" maxlength=50>\r\n                        <br/>\r\n                        * Дата документа:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_date_start_multi\" name=\"p_date_start_multi\" maxlength=10>\r\n                        <br/>\n <label id=\"ref_m3\"></label>\r\n                        <br/>\nПризнак копии:<input type=\"checkbox\" id=\"p_chk_copy_multi\" name=\"p_chk_copy_multi\">\r\n                         <br/>\r\n                         Электронный формат:<input type=\"checkbox\" id=\"p_chk_elec_form_multi\" name=\"p_chk_elec_form_multi\"  onChange=\"f_chng_count_multi(this)\">\r\n                         <br/>\r\n                         Цифровая подпись:<input type=\"checkbox\" id=\"p_chk_el_sign\" name=\"p_chk_el_sign\" onChange=\"f_switch_sign(this)\">\r\n                        <input type=\"hidden\" id=\"p_dossier\" name=\"p_dossier\" value =\"2216027\">\r\n            <input type=\"hidden\" id=\"p_sdossier_type\" name=\"p_sdossier_type\" value=\"36\">\r\n                        <input type=\"hidden\" id=\"p_parchitecture_multi\" name=\"p_parchitecture_multi\">\r\n                        <input type=\"hidden\" id=\"p_code\" name=\"p_code\" value=\"17\">\r\n                        <br/>\r\n                    </fieldset>\r\n                  </form>\r\n                </div>\n<div id=\"fail_doc_upd\" name=\"fail_doc_upd\" title=\"Редактирование документа\">\r\n             <form id=\"doc_upd\" name=\"doc_upd\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                <fieldset align=\"center\">\n* Кол-во листов/документов\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_count_paper_upd\" name=\"p_count_paper_upd\" maxlength=4 onKeyPress=\"return isNumberKey(event)\" >\r\n               <br/>\r\n               * Примечание\r\n               <br/>\r\n               <textarea id=\"p_note_upd\" name=\"p_note_upd\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n               <br/>\r\n               * Номер документа:\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_doc_num_upd\" name=\"p_doc_num_upd\" maxlength=50>\r\n               <br/>\r\n               * Дата документа:\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_date_start_upd\" name=\"p_date_start_upd\" maxlength=10>\r\n               <br/>\nПризнак копии:<input type=\"checkbox\" id=\"p_chk_copy_upd\" name=\"p_chk_copy_upd\">\r\n               <br/>\r\n               Электронный формат:<input type=\"checkbox\" id=\"p_chk_elec_form_upd\" name=\"p_chk_elec_form_upd\"  onChange=\"f_chng_count_upd(this)\">\r\n               <br/>\r\n               Цифровая подпись:<input type=\"checkbox\" id=\"p_chk_el_sign\" name=\"p_chk_el_sign\" onChange=\"f_switch_sign(this)\">\r\n               <input type=\"hidden\" id=\"p_parchitecture_upd\" name=\"p_parchitecture_upd\" value=\"\">\r\n               <input type=\"hidden\" id=\"p_sdossier_type\" name=\"p_sdossier_type\" value=\"36\">\r\n               <input type=\"hidden\" id=\"p_dos_document\" name=\"p_dos_document\">\r\n               <input type=\"hidden\" id=\"p_code\" name=\"p_code\" value=\"18\">\r\n               <br/>\r\n             </fieldset>\r\n           </form>\r\n           </div>\n<div id=\"fail_doc_chng\" name=\"fail_doc_chng\" title=\"Замена документа\">\r\n             <form id=\"doc_chng\" name=\"doc_chng\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                <fieldset align=\"center\">\n<label for=\"fail_d\">Выберите файл:</label>\r\n                  <br/>\r\n                  <input type=\"file\" name=\"p_file\"  id=\"fail_d\" size=\"40\">\r\n                  <br/>\n* Кол-во листов/документов\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_count_paper_chng\" name=\"p_count_paper_chng\" maxlength=4 onKeyPress=\"return isNumberKey(event)\">\r\n               <br/>\r\n               * Примечание\r\n               <br/>\r\n               <textarea id=\"p_note_chng\" name=\"p_note_chng\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n               <br/>\r\n               * Номер документа:\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_doc_num_chng\" name=\"p_doc_num_chng\" maxlength=50>\r\n               <br/>\r\n               * Дата документа:\r\n               <br/>\r\n               <input type=\"text\"   id=\"p_date_start_chng\" name=\"p_date_startchng\" maxlength=10>\r\n               <br/>\nПризнак копии:<input type=\"checkbox\" id=\"p_chk_copy_chng\" name=\"p_chk_copy_chng\">\r\n               <br/>\r\n               Электронный формат:<input type=\"checkbox\" id=\"p_chk_elec_form_chng\"  name=\"p_chk_elec_form_chng\">\r\n               <br/>\r\n               Цифровая подпись:<input type=\"checkbox\" id=\"p_chk_el_sign\" name=\"p_chk_el_sign\" onChange=\"f_switch_sign(this)\">\r\n               <input type=\"hidden\" id=\"p_parchitecture_chng\" name=\"p_parchitecture_chng\" value=\"\">\r\n               <input type=\"hidden\" id=\"p_sdossier_type\" name=\"p_sdossier_type\" value=\"36\">\r\n               <input type=\"hidden\" id=\"p_dos_document\" name=\"p_dos_document\">\r\n               <input type=\"hidden\" id=\"p_code\" name=\"p_code\" value=\"26\">\r\n               <br/>\r\n             </fieldset>\r\n           </form>\r\n           </div>\n<div id=\"fail_doc_out\" name=\"fail_doc_out\" title=\"Изъятие документа\">\r\n                  <form id=\"doc_out\" name=\"doc_out\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset>\r\n                        <div>\r\n                        <br/>\r\n                        Причина изъятия:\r\n                        <br/>\r\n                        <select name=\"p_pcut_note\" style=\"width:530;\" onChange=\"f_type_cut_note(this)\"><option value = 0> </option><option value = 1>Полное погашение обязательства</option><option value = 2>Замена документов по решению КК</option><option value = 3>Временное изъятие.Проведение повторной юридической экспертизы/по решению КК</option><option value = 4>Ведение претензионной работы</option><option value = 5>Выемка подлинников документов по санкции правоохранительных органов</option><option value = 6>Прочее, согласно решению полномочного КК</option><option value = 7>Высвобождение по решению КК</option><option value = 8>Без возврата по решение КК и т.д.</option><option value = 9>Перевод хранения на электронный формат согласно Протоколу НПС</option><option value = 10>В связи с продажей в коллекторское агентство</option></select>\r\n                        <br/>\r\n                        * Планируемая дата возврата:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_return_date\"   name=\"p_return_date\" maxlength=10>\r\n                        <br/>\r\n                        * Санкционирующий документ:\r\n                        <br/>\r\n                        <input type=\"file\" name=\"p_file_prot\" size=\"40\" onClick=\"f_focus();\">\r\n                        <br/>\r\n                        Докладчик:\r\n                        <br/>\r\n                        <input type=\"text\" id=\"p_search_in\"  size=\"40\"  > <input type=\"button\" id=\"b_add_manager\"    value=\"Поиск ФИО\">\r\n                        <input type=\"hidden\" id=\"p_search_value\" name = \"p_search_value\">\r\n                        <br/>\r\n                        <input type=\"hidden\" id=\"p_dossier\"           name=\"p_dossier\" value =\"2216027\">\r\n                        <input type=\"hidden\" id=\"p_parchitecture\"     name=\"p_parchitecture\">\r\n                        <input type=\"hidden\" id=\"p_code\"              name=\"p_code\" value=\"3\">\r\n                        <input type=\"hidden\" id=\"p_pdos_document_cut\" name=\"p_pdos_document_cut\">\r\n                        <br/>\r\n                        </div>\r\n                    </fieldset>\r\n                  </form>\r\n                 </div>\n<div id=\"fail_doc_out_acc\" name=\"fail_doc_out_acc\" title=\"Изъятие документа из подотчёта\">\r\n                  <form id=\"doc_out_acc\" name=\"doc_out_acc\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset>\r\n                        <div>\r\n                        <br/>\r\n                        Причина изъятия:\r\n                        <br/>\r\n                        <select name=\"p_pcut_note3\" style=\"width:530;\" onChange=\"f_type_cut_note3(this)\"><option value = 0> </option><option value = 1>Полное погашение обязательства</option><option value = 7>Высвобождение по решению КК</option><option value = 8>Без возврата по решение КК и т.д.</option><option value = 9>Перевод хранения на электронный формат согласно Протоколу НПС</option><option value = 10>В связи с продажей в коллекторское агентство</option></select>\r\n                        <br/>\r\n                        * Планируемая дата возврата:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_return_date3\"   name=\"p_return_date\" maxlength=10>\r\n                        <br/>\r\n                        * Санкционирующий документ:\r\n                        <br/>\r\n                        <input type=\"file\" name=\"p_file_prot\" size=\"40\" onClick=\"f_focus();\">\r\n                        <br/>\r\n                        Докладчик:\r\n                        <br/>\r\n                        <input type=\"text\" id=\"p_search_in\"  size=\"40\"  > <input type=\"button\" id=\"b_add_manager\"    value=\"Поиск ФИО\">\r\n                        <input type=\"hidden\" id=\"p_search_value3\" name = \"p_search_value\">\r\n                        <br/>\r\n                        <input type=\"hidden\" id=\"p_dossier\"           name=\"p_dossier\" value =\"2216027\">\r\n                        <input type=\"hidden\" id=\"p_parchitecture\"         name=\"p_parchitecture\">\r\n                        <input type=\"hidden\" id=\"p_code\"                  name=\"p_code\" value=\"31\">\r\n                        <input type=\"hidden\" id=\"p_pdos_document_cut_acc\" name=\"p_pdos_document_cut\">\r\n                        <br/>\r\n                        </div>\r\n                    </fieldset>\r\n                  </form>\r\n                 </div>\n<div id=\"fail_doc_replace\" name=\"fail_doc_replace\" title=\"Возврат документа с заменой\">\r\n                  <form id=\"doc_replace\" name=\"doc_replace\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset>\r\n                        <label for=\"fail_d\">Выберите файл:</label>\r\n                        <br/>\r\n                        <div>\r\n                        <input type=\"file\" name=\"p_file\" size=\"40\" onClick=\"f_focus();\">\r\n                        <br/>\r\n                        * Кол-во листов/документов\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_count_paper_return\" name=\"p_count_paper_return\" maxlength=4 onKeyPress=\"return isNumberKey(event)\">\r\n                        <br/>\r\n                        * Примечание\r\n                        <br/>\r\n                        <textarea id=\"p_note_return\" name=\"p_note_return\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n                        <br/>\r\n                        * Номер документа:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_doc_num_return\" name=\"p_doc_num_return\" maxlength=50>\r\n                        <br/>\r\n                        * Дата документа:\r\n                        <br/>\r\n                        <input type=\"text\"   id=\"p_date_start_return\" name=\"p_date_start_return\" maxlength=10>\r\n                        <br/>\nПризнак копии:<input type=\"checkbox\" id=\"p_chk_copy\" name=\"p_chk_copy\">\r\n                         <br/>\r\n                        Электронный формат:<input type=\"checkbox\" id=\"p_chk_elec_form\"  name=\"p_chk_elec_form\">\r\n                        <br/>\r\n                        Цифровая подпись:<input type=\"checkbox\" id=\"p_chk_el_sign\" name=\"p_chk_el_sign\" onChange=\"f_switch_sign(this)\">\r\n                        <input type=\"hidden\" id=\"p_dossier\" name=\"p_dossier\" value =\"2216027\">\r\n                        <input type=\"hidden\" id=\"p_parchitecture_1\" name=\"p_parchitecture_1\">\r\n                        <input type=\"hidden\" id=\"p_code\" name=\"p_code\" value=\"5\">\r\n            <input type=\"hidden\" id=\"p_sdossier_type\" name=\"p_sdossier_type\" value=\"36\">\r\n                        <input type=\"hidden\" id=\"p_pcust_shortname\" name=\"p_pcust_shortname\" value=\"9371817\">\r\n                        <input type=\"hidden\" id=\"p_pdos_document_cut_return\" name=\"p_pdos_document_cut_return\">\r\n                        <br/>\r\n                        </div>\r\n                    </fieldset>\r\n                  </form>\r\n                 </div>\n<div id=\"fail_doc_return\" name=\"fail_doc_return\" title=\"Вернуть на доработку\">\r\n                  <form id=\"dos_return\" name=\"dos_return\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset>\r\n                        <center>\r\n                        <div>\r\n                        <br/>\r\n                        * Причина возврата на доработку:\r\n                        <br/>\r\n                        <textarea id=\"p_return_to_job_note\" name=\"p_return_to_job_note\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n                        <br/>\r\n                        <br/>\r\n                        <input type=\"hidden\" id=\"p_dossier\" name=\"p_dossier\" value =\"2216027\">\r\n                        <input type=\"hidden\" id=\"p_code\" name=\"p_code\" value=\"7\">\r\n                        <input type=\"hidden\" id=\"p_access\"  name=\"p_access\" value=\"2\">\r\n                        <br/>\r\n                        </div>\r\n                        </center>\r\n                    </fieldset>\r\n                  </form>\r\n                </div>\n<div id=\"fail_doc_refuse\" name=\"fail_doc_refuse\" title=\"Отказать\">\r\n                  <form id=\"dos_refuse\" name=\"dos_refuse\" enctype=\"multipart/form-data\" action=\"pkg_w_e_dossier.p_action\" method=\"post\">\r\n                    <fieldset>\r\n                        <center>\r\n                        <div>\r\n                        <br/>\r\n                        * Причина отказа:\r\n                        <br/>\r\n                        <textarea id=\"p_return_refuse\" name=\"p_return_refuse\" style=\"height:100;width:200;\" wrap=\"hard\" maxlength=200></textarea>\r\n                