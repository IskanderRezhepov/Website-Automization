f\").css(\"color\", \"black\");\r\n$(\"#arc_on\").css(\"color\", \"#778899\");\r\n$(\"#arc_off\").css(\"color\", \"black\");\r\n\r\n$(\"#on\").click(function () {\r\n\t$(\"#on\").css(\"color\", \"#778899\");\r\n\t$(\"#off\").css(\"color\", \"black\");\r\n});\r\n$(\"#off\").click(function () {\r\n\t$(\"#off\").css(\"color\", \"#778899\");\r\n\t$(\"#on\").css(\"color\", \"black\");\r\n});\r\n$(\"#arc_on\").click(function () {\r\n\t$(\"#arc_on\").css(\"color\", \"#778899\");\r\n\t$(\"#arc_off\").css(\"color\", \"black\");\r\n});\r\n$(\"#arc_off\").click(function () {\r\n\t$(\"#arc_off\").css(\"color\", \"#778899\");\r\n\t$(\"#arc_on\").css(\"color\", \"black\");\r\n});\r\n/*-------Выбор архивных либо действующих документов------------*/\r\n\r\nfunction f_change_status_doc(id) {\r\n\tif (id == \"on\" || id == \"arc_on\") {\r\n\t\t$(\"#document_load\").show();\r\n\t\t$(\"#document_info\").attr(\"disabled\", true);\r\n\t\t$(\"#all_buttons\").attr(\"disabled\", true);\r\n\t\t$.ajax({\r\n\t\t\turl: \"pkg_w_e_dossier.p_document_info\",\r\n\t\t\ttype: \"POST\",\r\n\t\t\tdata: {\r\n\t\t\t\tp_pcust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n\t\t\t\tp_button: \"change_dossier\",\r\n\t\t\t\tp_dossier: $(\"#p_dossier\").val(),\r\n\t\t\t\tp_access: $(\"#n_access\").val()\r\n\t\t\t},\r\n\t\t\tsuccess: function (data) {\r\n\t\t\t\t$(\"#document_load\").hide();\r\n\t\t\t\t$(\"#document_info\").empty();\r\n\t\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t\t$(\"#on\").css(\"color\", \"#778899\");\r\n\t\t\t\t$(\"#off\").css(\"color\", \"black\");\r\n\t\t\t\t$(\"#arc_on\").css(\"color\", \"#778899\");\r\n\t\t\t\t$(\"#arc_off\").css(\"color\", \"black\");\r\n\t\t\t\t$(\"#document_info\").attr(\"disabled\", false);\r\n\t\t\t\t$(\"#all_buttons\").attr(\"disabled\", false);\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\tif (id == \"off\" || id == \"arc_off\") {\r\n\t\t$(\"#document_load\").show();\r\n\t\t$(\"#document_info\").attr(\"disabled\", true);\r\n\t\t$(\"#all_buttons\").