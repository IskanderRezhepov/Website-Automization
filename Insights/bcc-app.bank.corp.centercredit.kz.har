on_code = $(\"#h_action_\" + a + \"\").val();\r\n\t\tvar status_code = $(\"#h_status_\" + a + \"\").val();\r\n\t\tvar n_status = $(\"#h_n_status_\" + a + \"\").val();\r\n\t\tif (id == \"b_del_doc_2\") {\r\n\r\n\t\t\tif ((action_code == 1 & status_code == 1) || (action_code == 11 & status_code == 1) ||\r\n\t\t\t\t(action_code == 5 & status_code == 1 & n_status == 1) ||\r\n\t\t\t\t(action_code == 7)) {\r\n\t\t\t\tif (confirm(\"Удалить документ?\")) {\r\n\t\t\t\t\tf_download(\"open\");\r\n\t\t\t\t\t$.ajax({\r\n\t\t\t\t\t\turl: \"pkg_w_e_dossier.p_action\",\r\n\t\t\t\t\t\ttype: \"POST\",\r\n\t\t\t\t\t\tdata: {\r\n\t\t\t\t\t\t\tp_dossier: $(\"#h_pdossier\").val(),\r\n\t\t\t\t\t\t\tp_code: 2,\r\n\t\t\t\t\t\t\tp_parchitecture: $(\"input[name=r_parchitecture]:checked\").val(),\r\n\t\t\t\t\t\t\tp_pdos_document: $(\"#p_pdos_document\").val()\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tsuccess: function (data) {\r\n\t\t\t\t\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t\t\t\t\tif (id == \"b_del_doc_1\") {\r\n\t\t\t\t\t\t\t\tdocument_show();\r\n\t\t\t\t\t\t\t\tf_download(\"close\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tif (id == \"b_del_doc_2\") {\r\n\t\t\t\t\t\t\t\tdocument_show_2();\r\n\t\t\t\t\t\t\t\tf_download(\"close\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse {\r\n\t\t\t\talert(\"Удаление документа с данным статусом невозможно!\");\r\n\t\t\t}\r\n\t\t}\r\n\t\telse {\r\n\t\t\tif (confirm(\"Удалить документ?\")) {\r\n\t\t\t\tf_download(\"open\");\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: \"pkg_w_e_dossier.p_action\",\r\n\t\t\t\t\ttype: \"POST\",\r\n\t\t\t\t\tdata: {\r\n\t\t\t\t\t\tp_dossier: $(\"#h_pdossier\").val(),\r\n\t\t\t\t\t\tp_code: 2,\r\n\t\t\t\t\t\tp_parchitecture: $(\"input[name=r_parchitecture]:checked\").val(),\r\n\t\t\t\t\t\tp_pdos_document: $(\"#p_pdos_document\").val()\r\n\t\t\t\t\t},\r\n\t\t\t\t\tsuccess: function (data) {\r\n\t\t\t\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t\t\t\tif (id == \"b_del_doc_1\") {\r\n\