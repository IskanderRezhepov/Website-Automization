            "text": "\r\nvar allFields = $([]);\r\n\r\n$(document).ready(function () {\r\n\t$(function () {\r\n\t\t$(\"#tabs\").tabs().addClass(\"ui-tabs-gorizontal ui-helper-clearfix\");\r\n\t\t$(\"#tabs li\").removeClass(\"ui-corner-top\").addClass(\"ui-corner-left\");\r\n\t\t$(\"#tabs li a\").css(\"width\", \"300px\");\r\n\t\t$(\".ui-tabs .ui-tabs-nav\").css(\"padding-bottom\", \"0.4em\");\r\n\t\t$(\".ui-tabs .ui-tabs-nav\").css(\"margin\", \"0.2em\");\r\n\t});\r\n\r\n\t$(\"#tabs\").css(\"background\", \"#B0C4DE\");\r\n\t$(\"select[name=p_section]\").change(function () {\r\n\t\t$.post(\"pkg_w_e_dossier.p_list_document_architecture\",\r\n\t\t\t{\r\n\t\t\t\tp_ssection: $(\"select[name=p_section]\").val(),\r\n\t\t\t\tp_dossier: $(\"#p_dossier\").val()\r\n\t\t\t}).done(function (data) {\r\n\t\t\t\t$(\"#in_ssection\").html($(data).html());\r\n\t\t\t});\r\n\t});\r\n\r\n});\r\n\r\n/*-Парс дат-*/\r\n\r\nfunction parseDate(date_) {\r\n\tvar d, m, y;\r\n\tvar new_date = new Date();\r\n\tvar pattern = /(\\d{2})-(\\d{2})-(\\d{4})/;\r\n\tif (pattern.test(date_)) {\r\n\t\td = RegExp.$1;\r\n\t\tm = RegExp.$2;\r\n\t\ty = RegExp.$3;\r\n\t}\r\n\telse\r\n\t\treturn null;\r\n\tnew_date.setYear(y);\r\n\tnew_date.setMonth(m - 1);\r\n\tnew_date.setDate(d);\r\n\treturn new_date;\r\n};\r\n/*-------Перезагрузка области при добавлении, удалении в не сохраненном досье-------------*/\r\n\r\nfunction document_show() {\r\n\tvar old_active = $(\"#tabs\").tabs().tabs(\"option\", \"selected\");\r\n\r\n\tvar n_cnt_comm = 0;\r\n\tvar n_cnt_loan = 0;\r\n\tn_cnt_comm = ($(\"#h_comm_exist\").val()) ? $(\"#h_comm_exist\").val() : 0;\r\n\tn_cnt_loan = ($(\"#h_loan_exist\").val()) ? $(\"#h_loan_exist\").val() : 0;\r\n\tn_dossier_status = ($(\"#h_pdossier_status\").val()) ? $(\"#h_pdossier_status\").val() : 0;\r\n\tn_dossier_type = $(\"select[name=p_pdossier_type]\").val();\r\n\tif ((n_dossier_type != 27) || (n_dossier_type == 27 && n_cnt_comm == 0)) {\r\n\t\t//if((n_dossier_type!=27)||(n_dossier_type==27 && n_cnt_loan!=0)){                                                                                                                                                                                                                                                                                                                                                                    \r\n\t\t$.ajax({\r\n\t\t\turl: \"pkg_w_e_dossier.p_document_info\",\r\n\t\t\ttype: \"POST\",\r\n\t\t\tdata: {\r\n\t\t\t\tp_pcust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n\t\t\t\tp_button: \"add_dossier\",\r\n\t\t\t\tp_new_dossier_num: 0,\r\n\t\t\t\t/*  p_dossier_num     : $(\"#t_dossier_num\").val(), */\r\n\t\t\t\tp_dossier: $(\"#h_pdossier\").val(),\r\n\t\t\t\tp_sdossier_type: $(\"select[name=p_pdossier_type]\").val(),\r\n\t\t\t\tp_access: $(\"#n_access\").val()\r\n\t\t\t},\r\n\t\t\tsuccess: function (data) {\r\n\t\t\t\t$(\"#document_info\").empty();\r\n\t\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t\t$(\"#tabs\").tabs({ selected: old_active });\r\n\t\t\t}\r\n\t\t})\r\n\t\t/*} \r\n\t\telse {\r\n\t\t   alert(\"Вы не можете по данному клиенту добавить досье Общие документы, \\n так как в Колвире нет самостоятельных ИФ/Гарантий!\");\r\n\t\t   $(\"#b_save_dossier\").attr(\"disabled\",true);\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \r\n\t\t\t  }*/\r\n\t} else {\r\n\t\talert(\"Невозможно добавить 2-ое досье с типом Общие документы!\");\r\n\t\t$(\"#b_save_dossier\").attr(\"disabled\", true);\r\n\r\n\t}//end if                                                                                      \r\n};\r\n/*-Перезагрузка области при добавлении, удалении, одобрении, возврате в добавленом досье-*/\r\n\r\n/*-С перезагрузкой области досье-*/\r\n\r\nfunction document_show_1() {\r\n\tvar old_active = $(\"#tabs\").tabs().tabs(\"option\", \"selected\");\r\n\t$.ajax({\r\n\t\turl: \"pkg_w_e_dossier.p_document_info\",\r\n\t\ttype: \"POST\",\r\n\t\tdata: {\r\n\t\t\tp_pcust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n\t\t\tp_button: \"change_dossier\",\r\n\t\t\tp_dossier: $(\"#p_dossier\").val(),\r\n\t\t\tp_access: $(\"#n_access\").val()\r\n\t\t},\r\n\t\tsuccess: function (data) {\r\n\t\t\t$(\"#document_info\").empty();\r\n\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t$(\"#tabs\").tabs({ selected: old_active });\r\n\t\t}, error: function (xhr, status, error) {\r\n\t\t\tvar errorMessage = xhr.status + \": \" + xhr.statusText + \": \" + xhr.responseText;\r\n\t\t\talert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n\t\t\t$(\"#document_info\").empty();\r\n\t\t\t$(\"#tabs\").tabs({ selected: old_active });\r\n\t\t}\r\n\t});\r\n\r\n\t$.ajax({\r\n\t\turl: \"pkg_w_e_dossier.p_dossier_info\",\r\n\t\ttype: \"POST\",\r\n\t\tdata: {\r\n\t\t\tp_pcust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n\t\t\tp_dossier: $(\"#p_dossier\").val(),\r\n\t\t\tp_access: $(\"#n_access\").val()\r\n\t\t},\r\n\t\tsuccess: function (data) {\r\n\t\t\t$(\"#dossier_info\").empty();\r\n\t\t\t$(\"#dossier_info\").append(data);\r\n\t\t}, error: function (xhr, status, error) {\r\n\t\t\tvar errorMessage = xhr.status + \": \" + xhr.statusText + \": \" + xhr.responseText;\r\n\t\t\talert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n\t\t\t$(\"#dossier_info\").empty();\r\n\t\t}\r\n\t});\r\n};\r\n\r\n/*-Без перезагрузки области досье-*/\r\n\r\nfunction document_show_2() {\r\n\tvar old_active = $(\"#tabs\").tabs().tabs(\"option\", \"selected\");\r\n\t$.ajax({\r\n\t\turl: \"pkg_w_e_dossier.p_document_info\",\r\n\t\ttype: \"POST\",\r\n\t\tdata: {\r\n\t\t\tp_pcust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val(),\r\n\t\t\tp_button: \"change_dossier\",\r\n\t\t\tp_dossier: $(\"#p_dossier\").val(),\r\n\t\t\tp_access: $(\"#n_access\").val()\r\n\t\t},\r\n\t\tsuccess: function (data) {\r\n\t\t\t$(\"#document_info\").empty();\r\n\t\t\t$(\"#document_info\").append(data);\r\n\t\t\t$(\"#tabs\").tabs({ selected: old_active });\r\n\t\t}, error: function (xhr, status, error) {\r\n\t\t\tvar errorMessage = xhr.status + \": \" + xhr.statusText + \": \" + xhr.responseText;\r\n\t\t\talert(\"Веб-сервер вернул ошибку. Попробуйте выполнить еще раз. \" + errorMessage);\r\n\t\t\t$(\"#document_info\").empty();\r\n\t\t\t$(\"#tabs\").tabs({ selected: old_active });\r\n\t\t}\r\n\t});\r\n};\r\n/*-------------------------Вызов диалогов-------------------------------*/\r\n\r\n/*--Добавление-*/\r\nfunction f_doc_add_dial() {\r\n\tif ($(\"input[name=r_parchitecture]:checked\").val() == null) { alert(\"Выберите документ\"); }\r\n\telse {\r\n\r\n\t\t// if ( (($(\"input[name=r_parchitecture]:checked\").val()==\"2414\"||$(\"input[name=r_parchitecture]:checked\").val()==\"605\"||$(\"input[name=r_parchitecture]:checked\").val()==\"968\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1038\"||$(\"input[name=r_parchitecture]:checked\").val()==\"201\"||$(\"input[name=r_parchitecture]:checked\").val()==\"308\"||$(\"input[name=r_parchitecture]:checked\").val()==\"652\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1923\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1515\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1620\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1755\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1184\"||$(\"input[name=r_parchitecture]:checked\").val()==\"95\"||$(\"input[name=r_parchitecture]:checked\").val()==\"2451\"||$(\"input[name=r_parchitecture]:checked\").val()==\"630\"||$(\"input[name=r_parchitecture]:checked\").val()==\"623\"||$(\"input[name=r_parchitecture]:checked\").val()==\"409\"||$(\"input[name=r_parchitecture]:checked\").val()==\"507\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1860\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1505\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1635\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1757\"||$(\"input[name=r_parchitecture]:checked\").val()==\"1811\"||$(\"input[name=r_parchitecture]:checked\").val()==\"2241\"||$(\"input[name=r_parchitecture]:checked\").val()==\"2201\"||$(\"input[name=r_parchitecture]:checked\").val()==\"2202\"))\r\n\r\n\t\t// )\r\n\t\t// {\t\t\r\n\t\t//alert($(\"input[name=h_pcust_shortname]\").val());\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t//$(\"#ref_m1\").text(\"* Референс залога:\");\t\r\n\r\n\r\n\r\n\t\t//$(\"#ref_list1\").css(\"display\",\"block\"); \r\n\t\t//$.post(\"pkg_w_e_dossier.p_reference1\",\r\n\t\t// {                                                                            \r\n\t\t//p_scust_shortname: $(\"input[name=r_pcust_shortname]:checked\").val()//\"00672854\"\r\n\t\t//  }).done(function(data){\r\n\t\t//alert(data);\r\n\t\t//$(\"#p_sloan_agreement9\").html($(data).html());\r\n\t\t//\t\t  $(\"select[name=''p_reference'']\").html(data); \r\n\t\t//\t\t });\r\n\r\n\t\t/*$(\"#p_sloan_agreement1\").show();  \r\n\t\t$(\"#p_input_sloan1\").show();\r\n\t\t  \r\n\t\t$(\"#p_sloan_agreement\").hide();*/\r\n\t\t//}                \r\n\t\t//else{ \r\n\r\n\r\n\t\t//$(\"#ref_m1\").text(\"\");\r\n\r\n\r\n\r\n\r\n\r\n\t\t//$(\"#ref_list1\").css(\"display\",\"none\");\t\t\r\n\t\t//$.post(\"pkg_w_e_dossier.p_reference\",\r\n\t\t//  {                                                                            \r\n\t\t//  }).done(function(data){\r\n\t\t//alert(data);\r\n\t\t//$(\"#p_sloan_agreement9\").html($(data).html());\r\n\t\t//  $(\"select[name=''p_reference'']\").html(data); \r\n\t\t//});\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\t//}\r\n\t\tvar a = $(\"#p_pdos_document\").val();\r\n\t\tvar status_code = $(\"#h_status_\" + a + \"\").val() ? $(\"#h_status_\" + a + \"\").val() : \"\";\r\n\t\tif (status_code == \"\") {\r\n\t\t\tchk_count = $(\"#p_chk_count_paper\").val()\r\n\t\t\tif (chk_count == 1) {\r\n\t\t\t\t$(\"#p_count_paper\").attr(\"readonly\", true);\r\n\t\t\t}\r\n\t\t\t$(\"#fail_doc\").dialog(\"open\");\r\n\t\t\t$(\"#p_parchitecture\").val($(\"input[name=r_parchitecture]:checked\").val());\r\n\t\t}\r\n\t\telse {\r\n\t\t\talert(\"Файл уже добавлен\");\r\n\t\t};\r\n\t};\r\n};\r\nfunction f_chng_count(obj) {\r\n\tif (obj.checked) {\r\n\t\t$(\"input[name=p_count_paper]\").val(0);\r\n\t} else {\r\n\t\t$(\"input[name=p_count_paper]\").val(1);\r\n\t}\r\n};\r\nfunction f_switch_sign(obj) {\r\n\tif (obj.checked) {\r\n\t\t$(\"input[name=p_chk_elec_form]\").prop(\"disabled\", true).prop(\"checked\", true).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_upd]\").prop(\"disabled\", true).prop(\"checked\", true).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_chng]\").prop(\"disabled\", true).prop(\"checked\", true).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_multi]\").prop(\"disabled\", true).prop(\"checked\", true).trigger(\"change\");\r\n\t} else {\r\n\t\t$(\"input[name=p_chk_elec_form]\").prop(\"disabled\", false).prop(\"checked\", false).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_upd]\").prop(\"disabled\", false).prop(\"checked\", false).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_chng]\").prop(\"disabled\", false).prop(\"checked\", false).trigger(\"change\");\r\n\t\t$(\"input[name=p_chk_elec_form_multi]\").prop(\"disabled\", false).prop(\"checked\", false).trigger(\"change\");\r\n\t}\r\n};\r\n$(\"#fail_doc\").dialog({\r\n\tautoOpen: false,\r\n\theight: 420,\r\n\twidth: 420,\r\n\tparentBlock: $(\"#fail_doc\").parent(),\r\n\tmodal: true,\r\n\tresizeble: false,\r\n\tbuttons: {\r\n\t\t\"Добавить\": function () {\r\n\t\t\tf_focus();\r\n\t\t\tif (confirm(\"Добавить документ?\")) {\r\n\t\t\t\tif ($(\"#p_count_paper\").val() == \"\" ||\r\n\t\t\t\t\t$(\"#p_doc_num\").val() == \"\" ||\r\n\t\t\t\t\t$(\"#p_date_start\").val() == \"\" ||\r\n\t\t\t\t\t$(\"#p_note\").val() == \"\" ||\r\n\t\t\t\t\t$(\"input[name=p_file]\").val() == \"\" ||\r\n\t\t\t\t\t(($(\"select[name=p_parchitecture]\").val() == \"0\") || ($(\"select[name=p_parchitecture]\").val() == \