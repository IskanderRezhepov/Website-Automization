 Sans Serif;font-weight:bold\";\t\r\n}\r\n//document.onmousedown=mdn;\r\ndocument.onkeydown=kpres;\r\nwindow.onfocus=fcs;\r\ndocument.write(\"<a id='msg1' style='position:absolute;top:100;left:200;visibility:hidden'>РџРѕРґРѕР¶РґРёС‚Рµ...</a>\");\r\nHTMLStr=\"<table width=100% onselectstart=\" +C34+ \"return false;\" +C34+ \" ID='idTbar' border=0 bgcolor=<!--TopMenuBgColor--> CELLSPACING=0 CELLPADDING=0 background='<!--TopMenuBgImg-->' STYLE='cursor:default;position:absolute;left:-2;top:-2;width=102%'>\";\r\nif (ie==1) {\r\n\tHTMLStr=HTMLStr+\"<tr><td width='180'><!--IMG--></td><td noWrap='yes'><!--MENU_TITLES--></td><td nowrap id='MYTXT' align='right' style='color:\"+ArmFonColor+\"'></td>\";\r\n}\r\nelse {\r\n\tHTMLStr=HTMLStr+\"<tr width='100%'>\";\r\n\tHTMLStr=HTMLStr+\"<td width='10%'><!--IMG--></td>\";\r\n\tHTMLStr=HTMLStr+\"<td width='90%' noWrap='yes' ><!--MENU_TITLES--></td>\";\t\r\n}\r\n\r\nHTMLStr=HTMLStr+\"</tr>\";\r\nHTMLStr=HTMLStr+\"</table>\";\r\n\r\nfunction drawToolbar()\r\n{if (newindow == false) {window.focus()}\r\n imgStr = \"<div style='height:30'><img src='\"+imgLogo+\"' width='\"+LogoWidth+\"' height='\"+LogoHeight+\"'></div>\";\r\n HTMLStr = HTMLStr.replace(\"<!--IMG-->\", imgStr);\r\n HTMLStr = HTMLStr.replace(\"<!--TopMenuBgColor-->\", topMenuBgColor);\r\n HTMLStr = HTMLStr.replace(\"<!--TopMenuBgImg-->\", imgSpacer);\r\n document.write(HTMLStr);\r\n  TBar=document.getElementById(\"idTbar\");\r\n TBar.style.border=\"white 1 outset\";\r\n smsize();\r\n}\r\nfunction smsize()\r\n{for (m = 0; m < allsm.length; m++) {\r\n smobj=document.getElementById(allsm[m]);\r\n smobj.style.width=smobj.offsetWidth;}\r\n}\r\nfunction addMenu(MenuIDStr, MenuDisplayStr, MenuHelpStr, MenuURLStr, TargetStr, NeWindow)\r\n{tagStr = \"<!--MENU_TITLES-->\";\r\n TotalSubMenu = 0;\r\n ID_MM=\"M\" + MenuIDStr;\r\n MenuStr = C10;\r\n MenuStr += \"<A ID='\" +ID_MM+ \"'noWrap='yes' STYLE='text-decoration:none;font:\"+topMenuFont+\";cursor:default;padding:1;background-color: